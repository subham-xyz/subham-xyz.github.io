{
  "name": "kittysuite",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "validate:i18n": "node scripts/validate-translations.mjs",
    "test:i18n": "node tests/i18n.mjs",
    "test:language": "node tests/language-selector.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node tests/smoke.mjs",
    "test:ux": "node tests/ux.mjs",
    "test:loki": "node tests/loki.mjs",
    "test:region": "node tests/region.mjs",
    "test:local": "node tests/local-engine.mjs",
    "test:search": "node tests/search-intent.mjs",
    "test:metadata": "node tests/image-metadata.mjs",
    "test:odt": "node tests/odt-to-pdf.mjs",
    "test:limits": "node tests/device-limits.mjs",
    "build:models": "python scripts/build-upscale-model.py",
    "test:seo": "node tests/seo.mjs",
    "bench:fonts": "node tests/font-benchmark.mjs",
    "serve:dist": "node scripts/serve-dist.mjs dist 4322",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "test:tools": "node tests/image-core.mjs && node tests/four-tools.mjs && node tests/tool-edges.mjs",
    "lint": "eslint src scripts tests",
    "check": "astro check",
    "prebuild": "node scripts/copy-pdf-assets.mjs && node scripts/copy-local-engine-assets.mjs",
    "test:core": "node tests/product-core.mjs",
    "test:product": "node tests/product-browser.mjs",
    "build:font-index": "python scripts/build-font-index.py",
    "format": "prettier --write \"src/data/*.{ts,mjs}\" \"src/scripts/{catalogue,converter,font-*,image-*,local-files,pdf-*}.{ts,mjs}\" \"src/components/{BatchCompressor,HTMLTool,ImageEditor,PDFTool,ToolContent,LokiLesson}.astro\" \"tests/{product-*,password-fixture}.mjs\"",
    "format:check": "prettier --check \"src/data/*.{ts,mjs}\" \"src/scripts/{catalogue,converter,font-*,image-*,local-files,pdf-*}.{ts,mjs}\" \"src/components/{BatchCompressor,HTMLTool,ImageEditor,PDFTool,ToolContent,LokiLesson}.astro\" \"tests/{product-*,password-fixture}.mjs\"",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "test:i18n-coverage": "node tests/i18n-coverage.mjs",
    "test:i18n-runtime": "node tests/i18n-runtime.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "onnxruntime-web": "1.22.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "7.0.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.64.1",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
