{
  "name": "kittysuite",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node tests/smoke.mjs",
    "test:ux": "node tests/ux.mjs",
    "test:loki": "node tests/loki.mjs",
    "test:tools": "node tests/image-core.mjs && node tests/four-tools.mjs && node tests/tool-edges.mjs",
    "capture:guide": "node scripts/capture-guide.mjs",
    "lint": "eslint src scripts tests",
    "check": "astro check",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "test:core": "node tests/product-core.mjs",
    "test:product": "node tests/product-browser.mjs",
    "build:font-index": "python scripts/build-font-index.py",
    "format": "prettier --write \"src/data/*.{ts,mjs}\" \"src/scripts/{catalogue,converter,font-*,image-*,local-files,pdf-*}.{ts,mjs}\" \"src/components/{BatchCompressor,HTMLTool,ImageEditor,PDFTool,ToolContent,LokiLesson}.astro\" \"tests/{product-*,password-fixture}.mjs\"",
    "format:check": "prettier --check \"src/data/*.{ts,mjs}\" \"src/scripts/{catalogue,converter,font-*,image-*,local-files,pdf-*}.{ts,mjs}\" \"src/components/{BatchCompressor,HTMLTool,ImageEditor,PDFTool,ToolContent,LokiLesson}.astro\" \"tests/{product-*,password-fixture}.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
