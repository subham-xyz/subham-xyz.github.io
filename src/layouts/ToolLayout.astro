---
import Layout from './Layout.astro';import ToolContent from '../components/ToolContent.astro';import {tools} from '../data/tools';import {intents} from '../data/intents';
const {title,description,category='Images'}=Astro.props;
const intent=intents.find(i=>Astro.url.pathname.replaceAll('/','')===i.slug);
const tool=tools.find(t=>intent?t.id===intent.tool:Astro.url.pathname===t.href||Astro.url.pathname+'/'===t.href);
const metaDescription=intent?.description||tool?.description||description;
const schema={'@context':'https://schema.org','@type':'WebApplication',name:title,url:new URL(Astro.url.pathname,Astro.site).href,applicationCategory:category==='Fonts'?'DesignApplication':'UtilitiesApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}};
---
<Layout title={`${title} | KittySuite`} description={metaDescription}><div class="shell"><div class="tool-heading"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true"> / </span><a href={`/${(tool?.category||category).toLowerCase()}/`}>{tool?.category||category}</a><span aria-hidden="true"> / </span>{title}</nav><span class="pill">{tool?.category||category} &middot; Free, always</span><h1>{title}</h1><p>{description}</p><p class="local-note">100% on your device</p></div><slot />{tool&&<ToolContent tool={tool} intent={intent}/>}</div><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/></Layout>
