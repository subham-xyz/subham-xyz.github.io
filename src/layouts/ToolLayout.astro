---
import Layout from './Layout.astro';
const { title, description, category = 'Images' } = Astro.props;
---
<Layout title={`${title} — Free & private | KittySuite`} description={description}><div class="shell"><div class="tool-heading"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true"> / </span><a href="/#tools">Tools</a><span aria-hidden="true"> / </span>{title}</nav><span class="pill">{category} <span aria-hidden="true">✦</span> Free, always</span><h1>{title}</h1><p>{description}</p></div><slot /></div></Layout>