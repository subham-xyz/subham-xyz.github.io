---
import Layout from './Layout.astro';
import ToolContent from '../components/ToolContent.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { tools } from '../data/tools';
import { intents } from '../data/intents';
const { title, description, category = 'Images' } = Astro.props;
const intent = intents.find((i) => Astro.url.pathname.replaceAll('/', '') === i.slug);
const tool = tools.find((t) =>
  intent ? t.id === intent.tool : Astro.url.pathname === t.href || Astro.url.pathname + '/' === t.href,
);
const metaDescription = intent?.description || tool?.description || description;
const site = 'https://kittysuite.in';
const cat = tool?.category || category;
const pageTitle = intent ? title : `${title} — Free, No Upload`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: new URL(Astro.url.pathname, Astro.site).href,
  applicationCategory: cat === 'Fonts' ? 'DesignApplication' : 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript and a modern browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: `${cat} tools`, item: `${site}/${cat.toLowerCase()}/` },
    { '@type': 'ListItem', position: 3, name: title, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---

<Layout title={`${pageTitle} | KittySuite`} description={metaDescription}>
  <div class="shell">
    <div class="tool-heading">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true"> / </span><a href={`/${cat.toLowerCase()}/`}>{cat}</a><span aria-hidden="true"> / </span>{title}
      </nav>
      {tool && <ToolIcon id={tool.id} size="xl" />}
      <h1>{title}</h1>
      <p>{description}</p>
      <p class="local-note"><span class="status-dot"></span> Free · No upload · 100% on your device</p>
    </div>
    <slot />
    {tool && <ToolContent tool={tool} intent={intent} />}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replaceAll('<', '\\u003c')} />
</Layout>
