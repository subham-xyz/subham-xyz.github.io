---
import { localeFromPath } from '../i18n/config';
import { translator } from '../i18n';
import { routeFromPath, localizeHref } from '../i18n/routes';
import { localizedSeo } from '../i18n/seo';
const locale = localeFromPath(Astro.url.pathname);
const routeKey = routeFromPath(Astro.url.pathname);
const tr = translator(locale);
const localized = localizedSeo(locale, routeKey);
import Layout from './Layout.astro';
import ToolContent from '../components/ToolContent.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { tools } from '../data/tools';
import { intents } from '../data/intents';
import { toolSeo, localLine } from '../data/seo';
const { title, description, category = 'Images' } = Astro.props;
const intent = intents.find((i) => routeKey === i.slug);
const tool = tools.find((t) =>
  intent ? t.id === intent.tool : routeKey === t.id,
);
const seo = !intent && tool ? toolSeo[tool.id] : undefined;
const metaDescription = localized?.description || seo?.description || intent?.description || `${description} ${localLine}`;
const site = 'https://kittysuite.in';
const cat = tool?.category || category;
const pageTitle = seo ? seo.title : `${intent ? title : `${title} — Free, No Upload`} | KittySuite`;
const heading = localized?.h1 || seo?.h1 || title;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `KittySuite ${title}`,
  description: metaDescription,
  isAccessibleForFree: true,
  url: new URL(Astro.url.pathname, Astro.site).href,
  applicationCategory: cat === 'Fonts' ? 'DesignApplication' : 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript and a modern browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: tr('nav.home'), item: site + localizeHref(locale, '/') },
    { '@type': 'ListItem', position: 2, name: cat === 'Images' ? 'Image tools' : cat === 'Fonts' ? 'Font tools' : 'PDF tools', item: site + localizeHref(locale, `/${cat.toLowerCase()}/`) },
    { '@type': 'ListItem', position: 3, name: title, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---

<Layout title={pageTitle} description={metaDescription} toolPage>
  <div class="shell">
    <div class="tool-heading">
      <nav class="breadcrumb" aria-label={tr('common.breadcrumb')} data-i18n-aria-label="common.breadcrumb">
        <a href={localizeHref(locale, '/')} data-i18n="nav.home">{tr('nav.home')}</a><span aria-hidden="true"> / </span><a href={localizeHref(locale, `/${cat.toLowerCase()}/`)}>{cat === 'Images' ? tr('nav.images') : cat === 'Fonts' ? tr('nav.fonts') : cat}</a><span aria-hidden="true"> / </span>{title}
      </nav>
      {tool && <ToolIcon id={tool.id} size="xl" />}
      <h1>{heading}</h1>
      <p>{localized?.intro || description}</p>
      <p class="local-note"><span class="status-dot"></span> <span data-i18n="common.local">{tr('common.local')}</span></p>
    </div>
    <slot />
    {tool && <ToolContent tool={tool} intent={intent} />}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replaceAll('<', '\\u003c')} />
</Layout>
