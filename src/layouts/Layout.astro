---
import '../styles/global.css';
import font from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { createHash } from 'node:crypto';
const { connect = '', noindex = false, toolPage = false, image = '/brand/og-image.png', title = 'KittySuite — Free Image & PDF Tools That Never Upload Your Files', description = 'Friendly, free tools for your everyday files. Convert images right in your browser. No uploads, no accounts, just a little help from Loki.' } = Astro.props;
const themeScript = "(() => { let theme; try { theme = localStorage.getItem('kittysuite-theme'); } catch {} document.documentElement.dataset.theme = theme === 'dark' || theme === 'light' ? theme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; try { const zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; const langs = navigator.languages || [navigator.language || '']; if (!/^Asia\\/(Kolkata|Calcutta)$/.test(zone) && !langs.some((l) => /-IN$|^hi\\b/i.test(l))) document.documentElement.classList.add('not-india'); } catch {} })();";
const themeHash = createHash('sha256').update(themeScript).digest('base64');
// Optional services, switched on only by environment variables (see .env.example).
const gaId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '').trim();
const ga = /^G-[A-Z0-9]+$/.test(gaId) ? gaId : '';
const verification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '').trim();
const gaHosts = ga ? ' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com' : '';
const contentPolicy = `default-src 'self'; script-src 'self' 'sha256-${themeHash}' 'wasm-unsafe-eval'${ga ? ' https://www.googletagmanager.com' : ''}; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:${gaHosts}; font-src 'self' blob: data:; connect-src 'self'${connect ? ' ' + connect : ''}${gaHosts}; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8" /><meta http-equiv="Content-Security-Policy" content={contentPolicy}/><meta name="referrer" content="strict-origin-when-cross-origin"/><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
{verification && <meta name="google-site-verification" content={verification} />}
<meta property="og:site_name" content="KittySuite" /><meta property="og:locale" content="en_IN" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="KittySuite: little tools, big possibilities" />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImage} />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fffcf4" /><meta name="theme-color" media="(prefers-color-scheme: dark)" content="#152327" />
<link rel="icon" href="/favicon.ico" sizes="32x32" /><link rel="icon" type="image/png" href="/brand/favicon.png" /><link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" /><link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
<script is:inline set:html={themeScript} />
</head><body data-tool-page={toolPage ? '' : undefined} data-ga={ga || undefined}><a class="skip-link" href="#main">Skip to content</a><Header /><main id="main"><slot /></main><Footer /><script src="../scripts/site.ts"></script>{ga && <script src="../scripts/analytics.ts"></script>}</body></html>
