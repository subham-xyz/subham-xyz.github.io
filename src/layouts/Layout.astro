---
import { localeFromPath } from '../i18n/config';
import { routeFromPath, isPublished } from '../i18n/routes';
import { alternates, localizedSeo, ogLocales } from '../i18n/seo';
import { translator } from '../i18n';
import { runtimeCatalogue } from '../i18n/catalogues';
const locale = localeFromPath(Astro.url.pathname);
const routeKey = routeFromPath(Astro.url.pathname);
const tr = translator(locale);
import '../styles/global.css';
import font from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { createHash } from 'node:crypto';
const { connect = '', noindex = false, toolPage = false, image = '/brand/og-image.png', title = 'KittySuite — Free Image & PDF Tools That Never Upload Your Files', description = 'Friendly, free tools for your everyday files. Convert images right in your browser. No uploads, no accounts, just a little help from Loki.' } = Astro.props;
const themeScript = "(() => { let theme; try { theme = localStorage.getItem('kittysuite-theme'); } catch {} document.documentElement.dataset.theme = theme === 'dark' || theme === 'light' ? theme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; const icon = document.querySelector('link[data-kitty-favicon]'); if (icon) { icon.type = 'image/png'; icon.href = '/brand/loki-favicon-' + (document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark') + '.png'; } try { const zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; const langs = navigator.languages || [navigator.language || '']; if (!/^Asia\\/(Kolkata|Calcutta)$/.test(zone) && !langs.some((l) => /-IN$|^hi\\b/i.test(l))) document.documentElement.classList.add('not-india'); } catch {} })();";
const themeHash = createHash('sha256').update(themeScript).digest('base64');
// Translated header labels differ a lot in length. Right after the header is parsed
// (before first paint), hide the CTA, then fold the links into the menu, then hide
// the login button, only while they do not fit on one line. Any language, any width.
const headerScript = "(() => { const row = document.querySelector('.header-row'); if (!row) return; const steps = ['fit-cta', 'fit-nav', 'fit-login']; let frame = 0; const fit = () => { frame = 0; row.classList.remove(...steps); for (const step of steps) { if (row.scrollWidth <= row.clientWidth + 1) break; row.classList.add(step); } const nav = row.querySelector('.desktop-nav'); const menu = document.getElementById('mobile-nav'); if (menu && !menu.hidden && nav && getComputedStyle(nav).display !== 'none') { menu.hidden = true; document.getElementById('menu-toggle')?.setAttribute('aria-expanded', 'false'); } }; const later = () => { if (!frame) frame = requestAnimationFrame(fit); }; fit(); addEventListener('resize', later); if (document.fonts) document.fonts.ready.then(later); new MutationObserver(later).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] }); })();";
const headerHash = createHash('sha256').update(headerScript).digest('base64');
// Optional services, switched on only by environment variables (see .env.example).
const gaId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '').trim();
const ga = /^G-[A-Z0-9]+$/.test(gaId) ? gaId : '';
const verification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '').trim();
const gaHosts = ga ? ' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com' : '';
const contentPolicy = `default-src 'self'; script-src 'self' 'sha256-${themeHash}' 'sha256-${headerHash}' 'wasm-unsafe-eval'${ga ? ' https://www.googletagmanager.com' : ''}; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:${gaHosts}; font-src 'self' blob: data:; connect-src 'self'${connect ? ' ' + connect : ''}${gaHosts}; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'`;
const localized = localizedSeo(locale, routeKey);
const metaTitle = localized?.title || title;
const metaDescription = localized?.description || description;
const languageLinks = routeKey ? alternates(routeKey, Astro.site!) : [];
const indexable = locale === 'en' || (routeKey && isPublished(locale, routeKey));
const clientMessages = Object.fromEntries((['nav.open', 'nav.close', 'nav.light', 'nav.dark'] as const).map(key => [key, tr(key)]));
const canonical = new URL(Astro.url.pathname, Astro.site);
// Localized pages carry the phrases their scripts may write at runtime.
const runtime = locale === 'en' ? undefined : runtimeCatalogue(locale);
const ogImage = new URL(image, Astro.site);
---
<!doctype html><html lang={locale}><head>
<meta charset="utf-8" /><meta http-equiv="Content-Security-Policy" content={contentPolicy}/><meta name="referrer" content="strict-origin-when-cross-origin"/><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{metaTitle}</title><meta name="description" content={metaDescription} /><link rel="canonical" href={canonical} />{languageLinks.map(link => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}<meta name="robots" content={(noindex || !indexable) ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
{verification && <meta name="google-site-verification" content={verification} />}
<meta property="og:site_name" content="KittySuite" /><meta property="og:locale" content={ogLocales[locale]} />{languageLinks.filter(link => link.hreflang !== locale && link.hreflang !== 'x-default').map(link => <meta property="og:locale:alternate" content={ogLocales[link.hreflang as keyof typeof ogLocales]} />)}<meta property="og:title" content={metaTitle} /><meta property="og:description" content={metaDescription} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="KittySuite: little tools, big possibilities" />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={metaTitle} /><meta name="twitter:description" content={metaDescription} /><meta name="twitter:image" content={ogImage} />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fffcf4" /><meta name="theme-color" media="(prefers-color-scheme: dark)" content="#152327" />
<link rel="icon" href="/favicon.ico" sizes="48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" data-kitty-favicon /><link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" /><link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
<script is:inline set:html={themeScript} />
</head><body data-tool-page={toolPage ? '' : undefined} data-ga={ga || undefined}><a class="skip-link" href="#main" data-i18n="nav.skip">{tr('nav.skip')}</a><script id="i18n-messages" type="application/json" set:html={JSON.stringify(clientMessages).replaceAll('<', '\\u003c')} /><Header /><script is:inline set:html={headerScript} /><main id="main"><slot /></main><Footer /><script src="../scripts/site.ts"></script>{runtime && <script id="i18n-phrases" type="application/json" set:html={JSON.stringify(runtime).replaceAll('<', '\\u003c')} />}{runtime && <script src="../i18n/runtime.ts"></script>}{ga && <script src="../scripts/analytics.ts"></script>}</body></html>
