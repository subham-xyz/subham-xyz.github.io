---
import Layout from '../layouts/Layout.astro';
import Kitty from '../components/Kitty.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
const popular = tools
  .filter((t) => t.status === 'ready' && t.popular)
  .sort((a, b) => (a.popularOrder || 99) - (b.popularOrder || 99))
  .slice(0, 4);
---

<Layout title="Page not found | KittySuite" description="This page does not exist. Find the KittySuite tool you need instead." noindex>
  <div class="shell">
    <div class="tool-heading not-found">
      <div class="not-found-kitty"><Kitty small interactive={false} /></div>
      <p class="eyebrow">ERROR 404</p>
      <h1>Loki can’t find this page.</h1>
      <p>The link may be old or mistyped. Every tool is still here.</p>
      <div class="not-found-actions">
        <a class="button" href="/">Go to the homepage</a>
        <a class="button secondary" href="/#tools">Browse all tools</a>
      </div>
    </div>
    <section class="section" aria-labelledby="popular-title">
      <h2 id="popular-title" class="not-found-sub">Popular tools</h2>
      <div class="tool-grid">{popular.map((tool) => <ToolCard tool={tool} />)}</div>
    </section>
  </div>
</Layout>
