---
import Layout from '../layouts/Layout.astro';
import Kitty from '../components/Kitty.astro';
import LokiLesson from '../components/LokiLesson.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools, categories, popularTools } from '../data/tools';
---
<Layout>
<section class="shell hero"><div class="hero-copy"><span class="pill"><span class="status-dot"></span> Small tasks, meet your new sidekick</span><h1>Little tools.<br />Big <span class="headline-accent">possibilities.</span></h1><p class="hero-description">Everyday files, a little less fuss.<br />Free, friendly tools that help you get things done.<br class="desktop-break" /> With a little help from Loki.</p><div class="hero-actions"><a data-loki-transition class="button" href="/tools/image-converter/">Let’s make something easier <span aria-hidden="true">↗</span></a></div><div class="hero-notes" aria-label="Our commitments"><span>✓ Completely free</span><span>✓ No sign-up</span><span>✓ Yours stays yours</span></div></div>
<div class="hero-scene"><div class="scene-grid"></div><span class="scene-caption">YOUR EVERYDAY SIDEKICK</span><div class="kitty-greeting">Hey, I'm Loki <span aria-hidden="true">✦</span></div><Kitty /><div class="scene-bottom"><span class="status-dot"></span> A little mischief. A lot of help.</div></div></section>
<section class="shell section" id="most-popular"><div class="section-heading"><h2>Most popular</h2></div><p class="muted">Eight everyday starting points, selected by KittySuite.</p><div class="grid gap-5 md:grid-cols-4">{popularTools.map(tool=><ToolCard tool={tool}/>)}</div></section>
<div class="promise-strip"><div class="shell flex flex-wrap justify-between gap-4"><span>Less busywork. More good stuff.</span><span>Local processing <i>✦</i> Zero accounts <i>✦</i> A friendlier internet</span></div></div>
<div class="shell toolbox-jump"><a class="text-link" href="#tools">Explore the toolbox <span aria-hidden="true">↓</span></a></div>
<section class="shell section" id="tools"><div class="section-heading"><div><p class="eyebrow">THE LITTLE TOOLBOX</p><h2>Big help for small tasks.</h2></div><p class="muted">Images, PDFs and fonts. Your files stay local.</p></div>
<div class="category-row" role="tablist" aria-label="Tool categories">{categories.map((category,i)=><button id={`tab-${category}`} role="tab" aria-selected={i===0} aria-controls={`panel-${category}`} tabindex={i===0?0:-1} data-category-filter={category}>{category}</button>)}</div>
{categories.map(category=><section role="tabpanel" id={`panel-${category}`} aria-labelledby={`tab-${category}`} data-category-panel={category}><p class="mt-4"><a class="text-link" href={`/${category.toLowerCase()}/`}>Browse all {category} tools</a></p>{[...new Set(tools.filter(t=>t.category===category).map(t=>t.subcategory))].map(sub=><div class="tool-group"><h3>{sub}</h3><div class="grid gap-5 md:grid-cols-3">{tools.filter(t=>t.category===category&&t.subcategory===sub).map(tool=><ToolCard tool={tool}/>)}</div></div>)}</section>)}
<p class="tool-footnote">Only tools marked Ready to use are available. Coming soon tools have no active download workflow.</p></section>
<LokiLesson />
<section class="shell section" id="our-promise"><div class="privacy-panel"><div><p class="eyebrow">YOUR FILES. YOUR BUSINESS.</p><h2>Your files stay yours.<br />Loki stands guard.</h2><p>Your files are processed in your browser. They never leave your device. No account to create, no files for us to store. Just you, your work, and Loki.</p><a class="text-link" href="/tools/image-converter/">Try it for yourself <span aria-hidden="true">↗</span></a></div><div class="privacy-guardian"><div class="guardian-scene"><svg class="guardian-branches" viewBox="0 0 300 300" aria-hidden="true"><path d="M150 270V180M150 200C150 140 60 170 35 85M150 180C150 125 240 155 270 60M150 145V25M150 100L95 55M200 140L240 95"/></svg><Kitty pose="guard" interactive={true} /></div><div class="privacy-seal"><svg viewBox="0 0 48 56" aria-hidden="true"><path d="M24 3L43 10V26C43 39 34 48 24 53C14 48 5 39 5 26V10Z"/><path d="M15 27l6 6 13-14"/></svg><strong>100% on your device</strong></div><p>Every branch. Still yours.<br />No copies wandering off into another timeline.</p></div></div></section>
<script src="../scripts/catalogue.ts"></script>
</Layout>