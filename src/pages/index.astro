---
import Layout from '../layouts/Layout.astro';
import Kitty from '../components/Kitty.astro';
import LokiLesson from '../components/LokiLesson.astro';
import ToolCard from '../components/ToolCard.astro';
import IndiaSection from '../components/IndiaSection.astro';
import { tools, popularTools } from '../data/tools';
const ready = [
  ...popularTools.filter((t) => t.status === 'ready'),
  ...tools.filter((t) => t.status === 'ready' && !t.popular),
];
const soon = tools.filter((t) => t.status === 'soon');
const filters = ['All', 'Images', 'PDF', 'Fonts'];
const site = 'https://kittysuite.in';
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'KittySuite',
  url: site + '/',
  logo: site + '/brand/icon-512.png',
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'KittySuite',
  url: site + '/',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: site + '/?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Free online image, PDF and font tools',
  itemListElement: ready.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: site + t.href,
  })),
};
---

<Layout
  title="KittySuite — Free image & PDF tools that work in your browser"
  description="Compress, resize, convert and edit images and PDFs for free. 35 simple tools that run on your device, with no uploads and no sign-up."
>
  <section class="shell hero">
    <div class="hero-copy">
      <span class="pill"><span class="status-dot"></span> Small tasks, meet your new sidekick</span>
      <h1>Little tools.<br />Big <span class="headline-accent">possibilities.</span></h1>
      <p class="hero-description">
        Everyday files, a little less fuss.<br />Free, friendly tools that help you get things done.<br class="desktop-break" /> With a little help from Loki.
      </p>
      <div class="hero-actions">
        <a class="button" href="#tools">Let’s make something easier <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-notes" aria-label="Our commitments">
        <span>✓ Completely free</span><span>✓ No sign-up</span><span>✓ Yours stays yours</span>
      </div>
    </div>
    <div class="hero-scene">
      <div class="scene-grid"></div>
      <span class="scene-caption">YOUR EVERYDAY SIDEKICK</span>
      <div class="kitty-greeting">Hey, I'm Loki <span aria-hidden="true">✦</span></div>
      <Kitty />
      <div class="scene-bottom"><span class="status-dot"></span> A little mischief. A lot of help.</div>
    </div>
  </section>

  <section class="shell section tools-hub" id="tools" aria-labelledby="tools-title">
    <div class="tools-hub-head">
      <div>
        <p class="eyebrow">THE LITTLE TOOLBOX</p>
        <h2 id="tools-title">Every tool you need, in one place.</h2>
      </div>
      <form class="tool-search" role="search" action="/" method="get" data-tool-search>
        <label class="sr-only" for="home-search">Search tools</label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <input id="home-search" name="q" type="search" placeholder="Search: compress to 50 KB, merge PDF, signature…" autocomplete="off" enterkeyhint="search" />
      </form>
    </div>
    <div class="filter-row" aria-label="Filter tools by category">
      {filters.map((f, i) => (
        <button type="button" class="filter-chip" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f === 'All' ? 'All tools' : f}
        </button>
      ))}
      <a class="filter-chip filter-chip-link" href="#india" data-india-only>🇮🇳 Made for India</a>
    </div>
    <div class="recent-tools" id="recent-tools" hidden>
      <h3>Pick up where you left off</h3>
      <div class="tool-grid tool-grid-compact" id="recent-list"></div>
    </div>
    <div class="tool-grid" id="tool-grid">
      {ready.map((tool) => <ToolCard tool={tool} />)}
    </div>
    <div class="search-empty" id="search-empty" hidden>
      <p><strong>No tool matches that yet.</strong> Loki keeps a wish list.</p>
      <a class="button compact" href="/feedback/?type=feature">Request this tool <span aria-hidden="true">↗</span></a>
    </div>
    <div class="soon-row">
      <h3>On Loki’s list</h3>
      <p class="muted">Coming once they can work fully on your device.</p>
      <div class="tool-grid tool-grid-compact">
        {soon.map((tool) => <ToolCard tool={tool} compact />)}
      </div>
    </div>
  </section>

  <div class="promise-strip">
    <div class="shell flex flex-wrap justify-between gap-4">
      <span>Less busywork. More good stuff.</span><span>Local processing <i>✦</i> Zero accounts <i>✦</i> A friendlier internet</span>
    </div>
  </div>

  <div data-india-only><IndiaSection /></div>

  <LokiLesson />

  <section class="shell section" id="our-promise">
    <div class="privacy-panel">
      <div>
        <p class="eyebrow">YOUR FILES. YOUR BUSINESS.</p>
        <h2>Your files stay yours.<br />Loki stands guard.</h2>
        <p>
          Your files are processed in your browser. They never leave your device. No account to create, no files for us to store. Just you, your work, and Loki.
        </p>
        <a class="text-link" href="/privacy/">How we keep it private <span aria-hidden="true">↗</span></a>
      </div>
      <div class="privacy-guardian">
        <div class="guardian-scene"><Kitty pose="guard" interactive={true} /></div>
        <div class="privacy-seal">
          <svg viewBox="0 0 48 56" aria-hidden="true"><path d="M24 3L43 10V26C43 39 34 48 24 53C14 48 5 39 5 26V10Z" /><path d="M15 27l6 6 13-14" /></svg>
          <strong>100% on your device</strong>
        </div>
        <p>Nothing is uploaded. Nothing is stored.</p>
      </div>
    </div>
  </section>

  <section class="shell feedback-cta">
    <div>
      <h2>Missing a tool? Tell Loki.</h2>
      <p class="muted">Share feedback or request a feature. Every message is read.</p>
    </div>
    <a class="button" href="/feedback/">Send feedback <span aria-hidden="true">↗</span></a>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />
  <script src="../scripts/catalogue.ts"></script>
</Layout>
