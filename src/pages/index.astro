---
import Layout from '../layouts/Layout.astro';
import Kitty from '../components/Kitty.astro';
import ToolCard from '../components/ToolCard.astro';
import LokiLesson from '../components/LokiLesson.astro';
import IndiaSection from '../components/IndiaSection.astro';
import { tools, popularTools, toolGroups, groupNames, toolById } from '../data/tools';
import { homeFaqs, whyItems } from '../data/home-content';
const ready = tools.filter((t) => t.status === 'ready');
const popular = popularTools.filter((t) => t.status === 'ready');
const soon = tools.filter((t) => t.status === 'soon');
const count = ready.length;
const imageCount = ready.filter((t) => t.category === 'Images').length;
const pdfCount = ready.filter((t) => t.category === 'PDF').length;
const filters: [string, string][] = [
  ['all', 'All'],
  ['popular', 'Popular'],
  ['image', 'Image'],
  ['pdf', 'PDF'],
  ['creative', 'Creative'],
  ['utility', 'Utility'],
];
const link = (id: string) => toolById(id).href;
const site = 'https://kittysuite.in';
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'KittySuite',
  url: site + '/',
  logo: site + '/brand/icon-512.png',
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'KittySuite',
  url: site + '/',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: site + '/?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const json = (value: unknown) => JSON.stringify(value).replaceAll('<', '\\u003c');
---

<Layout
  title="Free Online Image & PDF Tools | KittySuite"
  description={`Compress, resize, convert and edit images and PDFs for free. ${count} simple tools that process your files in your browser, with no sign-up.`}
>
  <section class="shell hero-compact" aria-labelledby="hero-title">
    <div class="hero-mascot"><Kitty small /></div>
    <h1 id="hero-title">Free online image and <span class="headline-accent">PDF tools</span></h1>
    <p class="hero-description">Compress, resize, convert and edit your files right in your browser. No sign-up, and your files stay on your device.</p>
    <form class="tool-search hero-search" role="search" action="/" method="get" data-tool-search>
      <label class="sr-only" for="home-search">Search tools</label>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
      <input id="home-search" name="q" type="search" placeholder="What do you need? Compress to 50 KB, merge PDF…" autocomplete="off" enterkeyhint="search" aria-describedby="home-intent-status" />
      <div class="search-intent-pop" id="home-intent" hidden><a class="search-intent"></a></div>
      <p class="sr-only" id="home-intent-status" aria-live="polite"></p>
    </form>
    <p class="hero-notes">Free · No sign-up · Processed on your device</p>
  </section>

  <section class="shell popular-section" id="popular" aria-labelledby="popular-title">
    <div class="section-row">
      <h2 id="popular-title">Popular tools</h2>
      <a class="text-link" href="#tools">See all {count} tools <span aria-hidden="true">↓</span></a>
    </div>
    <div class="tool-grid tool-grid-popular">
      {popular.map((tool) => <ToolCard tool={tool} featured />)}
    </div>
  </section>

  <section class="shell section tools-hub" id="tools" aria-labelledby="tools-title">
    <div class="tools-hub-head">
      <h2 id="tools-title">All tools</h2>
      <p class="muted">Every tool runs in your browser. Pick a category or search above.</p>
    </div>
    <div class="filter-row" role="group" aria-label="Filter tools by category">
      {filters.map(([value, label], i) => (
        <button type="button" class="filter-chip" data-filter={value} aria-pressed={i === 0 ? 'true' : 'false'}>
          {label}
        </button>
      ))}
      <a class="filter-chip filter-chip-link" href="#india" data-india-only>🇮🇳 Made for India</a>
    </div>
    <div class="recent-tools" id="recent-tools" hidden>
      <h3>Pick up where you left off</h3>
      <div class="tool-grid tool-grid-compact" id="recent-list"></div>
    </div>
    <div id="tool-grid">
      {toolGroups.map((group) => (
        <section class="tool-group" data-group={group} aria-labelledby={`group-${group}`}>
          <h3 class="tool-group-title" id={`group-${group}`}><span class={`group-dot group-${group}`} aria-hidden="true"></span>{groupNames[group]}</h3>
          <div class="tool-grid">
            {ready.filter((t) => t.group === group).map((tool) => <ToolCard tool={tool} headingLevel={4} />)}
          </div>
        </section>
      ))}
    </div>
    <div class="search-empty" id="search-empty" hidden>
      <div class="search-empty-loki"><Kitty small interactive={false} /></div>
      <p><strong>No tool matches that yet.</strong> Loki keeps a wish list.</p>
      <a class="button compact" href="/feedback/?type=feature">Request this tool <span aria-hidden="true">↗</span></a>
    </div>
    <div class="soon-row">
      <h3>On Loki’s list</h3>
      <p class="muted">Coming once they can work fully on your device.</p>
      <div class="tool-grid tool-grid-compact">
        {soon.map((tool) => <ToolCard tool={tool} compact headingLevel={4} />)}
      </div>
    </div>
  </section>

  <section class="shell section why-section" aria-labelledby="why-title">
    <h2 id="why-title">Why KittySuite</h2>
    <ul class="why-grid">
      {whyItems.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <LokiLesson />

  <div data-india-only><IndiaSection /></div>

  <section class="shell section explore-section" aria-labelledby="explore-title">
    <h2 id="explore-title">Explore by category</h2>
    <div class="explore-grid">
      <a class="explore-card" href="/images/">
        <span class="group-dot group-image" aria-hidden="true"></span>
        <strong>Image tools</strong>
        <span>{imageCount} tools to compress, resize, convert, crop and edit photos.</span>
      </a>
      <a class="explore-card" href="/pdf/">
        <span class="group-dot group-pdf" aria-hidden="true"></span>
        <strong>PDF tools</strong>
        <span>{pdfCount} tools to merge, split, compress, sign and edit PDFs.</span>
      </a>
      <a class="explore-card" href="/fonts/">
        <span class="group-dot group-creative" aria-hidden="true"></span>
        <strong>Font Finder</strong>
        <span>Find free fonts that look like the text in your image.</span>
      </a>
    </div>
  </section>

  <section class="shell section home-guide" aria-labelledby="guide-title">
    <div class="home-guide-body">
      <h2 id="guide-title">Free image and PDF tools, without the busywork</h2>
      <p>
        KittySuite is a collection of {count} free online tools for everyday files: photos, screenshots, scans and PDF documents. Each tool does one job well, such as making an image smaller, turning photos into a PDF or adding page numbers. You do not need to install software or create an account. Open a tool, choose a file and download the result.
      </p>

      <h3>Free image tools</h3>
      <p>
        The most common job is reducing file size. <a href={link('image-compressor')}>Compress Image</a> lets you set a target such as 50 KB and shows the real size of the result before you download it. When a website asks for exact pixels, <a href={link('image-resizer')}>Resize Image</a> changes the width and height, and <a href={link('crop-image')}>Crop Image</a> trims the edges to a square, 4:3 or 16:9 frame. To change the format, use the <a href={link('image-converter')}>Image Converter</a> for JPG, PNG, WebP and AVIF, or <a href={link('convert-to-jpg')}>Convert to JPG</a> for older formats such as TIFF and BMP.
      </p>
      <p>
        For quick edits, the <a href={link('photo-editor')}>Photo Editor</a> adds text, filters and frames, and the <a href={link('watermark-image')}>Watermark Image</a> tool marks photos with your name or logo. <a href={link('upscale')}>Upscale Image</a> enlarges small photos with a model that runs on your device.
      </p>

      <h3>Free PDF tools</h3>
      <p>
        Combine documents with <a href={link('merge-pdf')}>Merge PDF</a>, separate them with <a href={link('split-pdf')}>Split PDF</a>, or reduce their size with <a href={link('compress-pdf')}>Compress PDF</a>. Turn photos and scans into one document with <a href={link('jpg-to-pdf')}>JPG to PDF</a>, or save pages as images with <a href={link('pdf-to-jpg')}>PDF to JPG</a>. There are also tools to <a href={link('sign-pdf')}>sign</a>, <a href={link('protect-pdf')}>password-protect</a>, <a href={link('redact-pdf')}>redact</a> and <a href={link('ocr-pdf')}>make scanned PDFs searchable</a>.
      </p>

      <h3>Local processing and privacy</h3>
      <p>
        Many online converters upload your file to a server. KittySuite works differently: the tools run inside your browser, so your photos and documents are processed on your own device and are not uploaded to KittySuite. The page may download the code it needs, such as a PDF engine or a font index, from this site. Some heavy tools, like OCR and upscaling, download a larger file once and keep it in your browser for next time.
      </p>
      <p>
        If you want to remove private details before sharing a picture, <a href={link('remove-image-metadata')}>Remove Image Metadata</a> strips EXIF data such as GPS location, and <a href={link('blur-face')}>Blur Face</a> hides faces or number plates.
      </p>

      <h3>How to choose the right tool</h3>
      <ul class="guide-list">
        <li><strong>File too large to upload?</strong> Try <a href={link('image-compressor')}>Compress Image</a> or <a href={link('compress-pdf')}>Compress PDF</a>. If an image is still too big, resize it first.</li>
        <li><strong>Wrong dimensions?</strong> Use <a href={link('image-resizer')}>Resize Image</a> for exact pixels, or <a href={link('crop-image')}>Crop Image</a> to change the shape.</li>
        <li><strong>Site only accepts one format?</strong> Use the <a href={link('image-converter')}>Image Converter</a> for images, or <a href={link('jpg-to-pdf')}>JPG to PDF</a> when a PDF is required.</li>
        <li><strong>Need to check a file first?</strong> The <a href={link('image-size-checker')}>Image Size Checker</a> shows the size in KB, the pixels and the real format.</li>
        <li><strong>Want to know a font?</strong> <a href={link('font-finder')}>Font Finder</a> compares the letters in your image with a library of free fonts.</li>
      </ul>
      <p>
        You can also type what you need into the search box at the top of the page. Plain phrases such as “compress image to 20 KB”, “resize 1080x1080” or “jpg to pdf” open the right tool with the settings filled in.
      </p>

      <h3>Using KittySuite on desktop and mobile</h3>
      <p>
        The tools are built for current versions of Chrome, Edge, Firefox and Safari, on computers and phones. On a phone, you can pick photos straight from your gallery or camera. Because the work happens on your device, very large PDFs or high-resolution photos can take longer on older phones. If a task fails, try a smaller file or use a computer.
      </p>
    </div>

    <div class="home-faq">
      <h2 id="faq-title">Frequently asked questions</h2>
      {homeFaqs.map((faq) => (
        <details>
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="shell feedback-cta">
    <div>
      <h2>Missing a tool? Tell Loki.</h2>
      <p class="muted">Share feedback or request a feature. Every message is read.</p>
    </div>
    <a class="button" href="/feedback/">Send feedback <span aria-hidden="true">↗</span></a>
  </section>

  <script type="application/ld+json" set:html={json(orgSchema)} />
  <script type="application/ld+json" set:html={json(websiteSchema)} />
  <script type="application/ld+json" set:html={json(faqSchema)} />
  <script src="../scripts/catalogue.ts"></script>
</Layout>
