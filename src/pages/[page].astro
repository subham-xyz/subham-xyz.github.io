---
import { intents } from '../data/intents';
import { categories, tools } from '../data/tools';
import ImageTool from '../components/ImageTool.astro';
import ToolLayout from '../layouts/ToolLayout.astro';
import Layout from '../layouts/Layout.astro';
import PDFTool from '../components/PDFTool.astro';
import ToolCard from '../components/ToolCard.astro';
import Kitty from '../components/Kitty.astro';
import ImageEditor from '../components/ImageEditor.astro';
import HTMLTool from '../components/HTMLTool.astro';
import AIImageTool from '../components/AIImageTool.astro';
import OdtTool from '../components/OdtTool.astro';
import MediaTool from '../components/MediaTool.astro';
export function getStaticPaths() {
  return [
    ...intents.map((intent) => ({ params: { page: intent.slug }, props: { intent, category: undefined } })),
    ...categories.map((category) => ({ params: { page: category.toLowerCase() }, props: { category, intent: undefined } })),
    // Every ready tool lives at its own root URL, e.g. /merge-pdf/. Compressor, resizer,
    // converter and font finder have dedicated pages in this folder.
    ...tools
      .filter((t) => t.status === 'ready' && !['existing', 'font'].includes(t.engine))
      .map((t) => ({ params: { page: t.slug }, props: { page: t, intent: undefined, category: undefined } })),
  ];
}
const { intent, category, page } = Astro.props;
const selected = tools.filter((t) => t.category === category);
const readyCount = selected.filter((t) => t.status === 'ready').length;
const headings: Record<string, string> = { Images: 'Image tools', PDF: 'PDF tools', Video: 'Video & GIF tools', Audio: 'Audio tools', Fonts: 'Font tools' };
const copy: Record<string, string> = {
  Images: 'Compress, resize, crop, convert and edit photos. Every tool runs on your device.',
  PDF: 'Merge, split, compress, sign and edit PDFs without uploading them anywhere.',
  Video: 'Convert, compress, trim and edit videos, and make GIFs. Every tool runs on your device.',
  Audio: 'Convert, trim, join and clean up audio and recordings. Every tool runs on your device.',
  Fonts: 'Find a free font that looks like the text in your image.',
};
const titles: Record<string, string> = {
  Images: 'Free image tools: compress, resize, convert | KittySuite',
  PDF: 'Free PDF tools: merge, split, compress, sign | KittySuite',
  Video: 'Free video tools: compress, convert, trim, GIF | KittySuite',
  Audio: 'Free audio tools: convert, trim, join, normalise | KittySuite',
  Fonts: 'Free font finder: find similar fonts from images | KittySuite',
};
---

{page ? (
  <ToolLayout title={page.name} description={page.description} category={page.category}>
    <noscript><p>This tool needs JavaScript for local processing. Your files are not uploaded.</p></noscript>
    {page.engine === 'image' ? <ImageEditor tool={page} /> : page.engine === 'html' ? <HTMLTool tool={page} /> : page.engine === 'ai' ? <AIImageTool tool={page} /> : page.engine === 'odt' ? <OdtTool tool={page} /> : page.engine === 'media' ? <MediaTool tool={page} /> : <PDFTool tool={page} />}
  </ToolLayout>
) : category ? (
  <Layout title={titles[category]} description={`${copy[category]} Free, no sign-up, no uploads.`}>
    <section class="shell page-hero">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true"> / </span>{category}</nav>
        <span class="pill"><span class="status-dot"></span> {readyCount} free {readyCount === 1 ? 'tool' : 'tools'} · 100% on your device</span>
        <h1>{headings[category]}</h1>
        <p class="page-lead">{copy[category]}</p>
      </div>
      <div class="page-hero-kitty"><Kitty small interactive={false} /></div>
    </section>
    <section class="shell section category-section">
      {[...new Set(selected.map((t) => t.subcategory))].map((sub) => (
        <section class="tool-group">
          <h2>{sub}</h2>
          <div class="tool-grid">
            {selected.filter((t) => t.subcategory === sub).map((tool) => <ToolCard tool={tool} />)}
          </div>
        </section>
      ))}
    </section>
  </Layout>
) : (
  <ImageTool
    mode={intent!.tool === 'image-compressor' ? 'compressor' : 'resizer'}
    titleOverride={intent!.title}
    descriptionOverride={intent!.description}
    target={intent!.target}
    exam={intent!.tool === 'image-resizer'}
  />
)}
