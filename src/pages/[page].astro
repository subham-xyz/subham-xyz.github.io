---
import {intents} from '../data/intents';import {categories,tools,toolById} from '../data/tools';import ImageTool from '../components/ImageTool.astro';import ToolLayout from '../layouts/ToolLayout.astro';import Layout from '../layouts/Layout.astro';import PDFTool from '../components/PDFTool.astro';import ToolCard from '../components/ToolCard.astro';
export function getStaticPaths(){return [...intents.map(intent=>({params:{page:intent.slug},props:{intent,category:undefined}})),...categories.map(category=>({params:{page:category.toLowerCase()},props:{category,intent:undefined}}))];}
const {intent,category}=Astro.props;const tool=intent?toolById(intent.tool):undefined;const selected=tools.filter(t=>t.category===category);
---
{category?<Layout title={`${category} tools - Free & local | KittySuite`} description={`Explore free ${category.toLowerCase()} tools that process files on your device. Choose a working tool or see what is coming next.`}><section class="shell section"><h1>{category} tools</h1><p>Simple utilities. 100% on your device.</p>{[...new Set(selected.map(t=>t.subcategory))].map(sub=><section class="tool-group"><h2>{sub}</h2><div class="grid gap-5 md:grid-cols-3">{selected.filter(t=>t.subcategory===sub).map(tool=><ToolCard tool={tool}/>)}</div></section>)}</section></Layout>:tool!.engine==='existing'?<ImageTool mode={intent!.tool==='image-compressor'?'compressor':'resizer'} titleOverride={intent!.title} descriptionOverride={intent!.description} target={intent!.target} exam={intent!.tool==='image-resizer'}/>:<ToolLayout title={intent!.title} description={intent!.description} category="PDF"><PDFTool tool={tool}/></ToolLayout>}
