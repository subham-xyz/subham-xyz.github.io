---
import { localeFromPath } from '../i18n/config';
import { translator } from '../i18n';
const locale = localeFromPath(Astro.url.pathname);
const tr = translator(locale);
import ToolCard from './ToolCard.astro';
import Kitty from './Kitty.astro';
import { relatedTools } from '../data/tools';
const { id, title = tr('common.related'), count = 6, headingLevel = 2 } = Astro.props;
const list = relatedTools(id, count);
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---

<section class="related-box" aria-label={title}>
  <div class="related-head">
    <div class="loki-mini"><Kitty small interactive={false} /></div>
    <div class="loki-bubble">
      <Heading>{title}</Heading>
      <p data-i18n="common.relatedNote">{tr('common.relatedNote')}</p>
    </div>
  </div>
  <div class="tool-grid tool-grid-related">
    {list.map((tool) => <ToolCard tool={tool} />)}
  </div>
</section>
