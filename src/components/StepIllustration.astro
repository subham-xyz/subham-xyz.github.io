---
import Kitty from './Kitty.astro';
const { step } = Astro.props;
const captions = { '01': 'Start with your image.', '02': 'A fresh format? Easy.', '03': 'All yours. Off you go!' };
---
<div class="step-illustration" aria-label={`Loki says: ${captions[step as keyof typeof captions]}`} role="img">
  <div class="mini-window" aria-hidden="true">
    <div class="mini-window-bar"><i></i><i></i><i></i></div>
    {step === '01' && <div class="mini-drop"><svg viewBox="0 0 80 60"><rect x="12" y="6" width="56" height="46" rx="6"/><circle cx="30" cy="22" r="5"/><path d="M15 45l18-17 12 11 10-9 11 15"/></svg><span>your-image.png</span></div>}
    {step === '02' && <div class="mini-form"><span>New format</span><strong>WebP <span>✓</span></strong><div class="mini-slider"><i></i></div><small>A little lighter. Just right.</small></div>}
    {step === '03' && <div class="mini-result"><span class="mini-check">✓</span><strong>Ready to download</strong><span>your-image.webp ↓</span></div>}
  </div>
  <div class="step-loki" aria-hidden="true"><Kitty small interactive={false} /></div>
  <p class="step-speech">{captions[step as keyof typeof captions]}</p>
</div>
