---
import ToolIcon from './ToolIcon.astro';
import { metaFor } from '../data/tool-meta';
import { groupNames, type Tool } from '../data/tools';
interface Props {
  tool: Tool;
  compact?: boolean;
  featured?: boolean;
  headingLevel?: 2 | 3 | 4;
  /** Homepage only: hidden while browsing "All", shown by search and filters. */
  more?: boolean;
}
const { tool, compact = false, featured = false, headingLevel = 3, more = false } = Astro.props;
const keywords = `${tool.name} ${tool.summary} ${tool.description} ${tool.category} ${groupNames[tool.group]} ${metaFor(tool.id).keywords}`.toLowerCase();
const Heading = headingLevel === 2 ? 'h2' : headingLevel === 4 ? 'h4' : 'h3';
---

{tool.available ? (
  <a
    href={tool.href}
    class:list={['tool-card', { 'tool-card-compact': compact, 'tool-card-featured': featured }]}
    data-tool-card
    data-tool-id={tool.id}
    data-tool-name={tool.name}
    data-tool-category={tool.category}
    data-tool-group={tool.group}
    data-popular={tool.popular ? '' : undefined}
    data-keywords={keywords}
    data-more={more ? '' : undefined}
    hidden={more}
  >
    <ToolIcon id={tool.id} />
    <span class="tool-card-text">
      <span class="tool-card-title">
        <Heading>{tool.name}</Heading>
        <span class="tool-card-go" aria-hidden="true">→</span>
      </span>
      {!compact && <p>{tool.summary}</p>}
    </span>
  </a>
) : (
  <article
    class:list={['tool-card', 'tool-card-soon', { 'tool-card-compact': compact }]}
    data-tool-category={tool.category}
    data-tool-group={tool.group}
  >
    <ToolIcon id={tool.id} />
    <span class="tool-card-text">
      <span class="tool-card-title">
        <Heading>{tool.name}</Heading>
        <span class="soon-badge">Soon</span>
      </span>
      {!compact && <p>{tool.summary}</p>}
    </span>
  </article>
)}
