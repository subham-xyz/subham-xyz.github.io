---
import ToolIcon from './ToolIcon.astro';
import { metaFor } from '../data/tool-meta';
const { tool, compact = false } = Astro.props;
const keywords = `${tool.name} ${tool.description} ${tool.category} ${metaFor(tool.id).keywords}`.toLowerCase();
---

{tool.available ? (
  <a
    href={tool.href}
    class:list={['tool-card', { 'tool-card-compact': compact }]}
    data-tool-card
    data-tool-category={tool.category}
    data-keywords={keywords}
  >
    <ToolIcon id={tool.id} />
    <span class="tool-card-text">
      <h3>{tool.name}</h3>
      {!compact && <p>{tool.description}</p>}
    </span>
    <span class="tool-card-go" aria-hidden="true">↗</span>
  </a>
) : (
  <article
    class:list={['tool-card', 'tool-card-soon', { 'tool-card-compact': compact }]}
    data-tool-card
    data-tool-category={tool.category}
    data-keywords={keywords}
  >
    <ToolIcon id={tool.id} />
    <span class="tool-card-text">
      <h3>
        {tool.name} <span class="soon-badge">Soon</span>
      </h3>
      {!compact && <p>{tool.description}</p>}
    </span>
  </article>
)}
