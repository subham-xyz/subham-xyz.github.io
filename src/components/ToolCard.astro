---
const { tool } = Astro.props;
---
<article data-tool-category={tool.category} class:list={['tool-card', tool.tone]}><div class="flex justify-between items-center gap-4"><span class="tool-icon" aria-hidden="true">{tool.icon}</span><span class="eyebrow text-xs">{tool.tag}</span></div><div class="mt-10"><h3>{tool.name}</h3><p class="mt-3">{tool.description}</p></div><div class="card-bottom"><span>{tool.category}</span>{tool.available ? <a class="round-link" href={tool.href} aria-label={`Open ${tool.name}`}>↗</a> : <span class="soon-label">On Kitty’s list</span>}</div></article>