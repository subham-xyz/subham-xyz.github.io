---
import RelatedTools from './RelatedTools.astro';
import { guides } from '../data/tool-content';
import { metaFor } from '../data/tool-meta';
import { toolFaqs } from '../data/tool-faqs';
const { tool, intent } = Astro.props;
const guide = guides[tool.id] || [];
const meta = metaFor(tool.id);
const imageInput =
  tool.category === 'Images' || ['jpg-to-pdf', 'scan-to-pdf'].includes(tool.id);
const input =
  tool.id === 'font-finder'
    ? 'a screenshot or photo of the text'
    : tool.engine === 'html'
      ? 'your HTML, or paste it in'
      : tool.id === 'scan-to-pdf'
        ? 'your camera or photos of each page'
        : imageInput
          ? tool.id === 'jpg-to-pdf' ||
            tool.id === 'rotate-image' ||
            tool.id === 'remove-image-metadata' ||
            tool.id === 'convert-from-jpg'
            ? 'your images'
            : 'your image'
          : tool.id === 'merge-pdf'
            ? 'your PDFs'
            : tool.id === 'compare-pdf'
              ? 'the two PDFs'
              : 'your PDF';
const steps =
  tool.id === 'font-finder'
    ? [
        `Choose ${input}.`,
        'Crop one line of text and type the words exactly as shown.',
        'Select Compare fonts.',
        'Review the closest matches and open each font’s source and licence.',
      ]
    : tool.id === 'image-size-checker'
      ? [
          `Choose ${input}, or drop it on the page.`,
          'Read the size, dimensions, format and metadata in the side panel.',
          'Compare them with the limits of the form or site you are uploading to.',
          'If it is too big, continue to Compress or Resize. Nothing was uploaded.',
        ]
      : [
          `Choose ${input}, or drop it on the page.`,
          'Adjust the settings in the side panel. The preview updates as you go.',
          `Select ${meta.action}.`,
          'Download the result. Your original file is left unchanged.',
        ];
const generic = [
  {
    q: 'Does my content leave my device?',
    a: 'No file contents or typed text are sent for processing. This site downloads its own code and assets when needed; the Privacy page explains hosting requests and browser caching.',
  },
  {
    q: `What should I check before using ${tool.name}?`,
    a: guide[1]?.split('. ').slice(0, 2).join('. ') + '.',
  },
  {
    q: 'What if the result is not suitable?',
    a: 'Keep your original, return to the settings and try again. An unreadable input or unsupported structure may need a fresh export from its original application.',
  },
  {
    q: 'Can I use this on a phone?',
    a: 'The controls adapt to smaller screens, but large files can exceed mobile memory. Use a smaller input or work in batches if processing fails.',
  },
];
// High-intent tools get their own questions; the privacy and phone answers still apply.
const specific = toolFaqs[tool.id];
const faqs = specific
  ? [...specific, generic[0], generic[3]]
  : generic.filter((f) => !f.a.startsWith('undefined'));
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="tool-details">
  <div class="how-to-use">
    <h2>How to use {tool.name}</h2>
    <ol class="how-steps">
      {steps.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
    <p class="privacy-note">
      <strong>Private by design.</strong> Your files are processed in this
      browser tab and are never uploaded to KittySuite.
    </p>
  </div>
  <div class="about-card">
    <h2>
      {intent
        ? `Preparing your ${intent.title.toLowerCase()} result`
        : `About ${tool.name}`}
    </h2>
    {intent && <p>{intent.guide}</p>}
    {guide.map((p) => (
      <p>{p}</p>
    ))}
  </div>
  <h2>
    {specific
      ? `${tool.name}: frequently asked questions`
      : 'Questions before you start'}
  </h2>
  {faqs.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
  <p class="privacy-link">
    <a href="/privacy/">Read the privacy details</a>
  </p>
</section>
<RelatedTools id={tool.id} />
<script
  type="application/ld+json"
  set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')}
/>
