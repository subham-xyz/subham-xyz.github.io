---
import Kitty from './Kitty.astro';
import ToolResult from './ToolResult.astro';
import { metaFor } from '../data/tool-meta';
const { tool } = Astro.props;
const mode = tool.id;
const meta = metaFor(mode);
const images = ['jpg-to-pdf', 'scan-to-pdf'].includes(mode);
const multi =
  images ||
  ['merge-pdf', 'organize-pdf', 'compare-pdf', 'compress-pdf'].includes(mode);
const previewModes = [
  'page-numbers',
  'watermark-pdf',
  'edit-pdf',
  'sign-pdf',
  'crop-pdf',
  'redact-pdf',
  'pdf-forms',
  'compare-pdf',
];
const view = previewModes.includes(mode) ? 'preview' : 'grid';
const rangeModes = [
  'ocr-pdf',
  'rotate-pdf',
  'pdf-to-jpg',
  'pdf-to-text',
  'page-numbers',
  'watermark-pdf',
  'edit-pdf',
  'sign-pdf',
  'crop-pdf',
];
const placement = [
  'page-numbers',
  'watermark-pdf',
  'edit-pdf',
  'sign-pdf',
].includes(mode);
const positions = [
  [10, 6, 'Top left'],
  [50, 6, 'Top'],
  [90, 6, 'Top right'],
  [10, 50, 'Left'],
  [50, 50, 'Centre'],
  [90, 50, 'Right'],
  [10, 95, 'Bottom left'],
  [50, 95, 'Bottom'],
  [90, 95, 'Bottom right'],
];
const defaultPos =
  mode === 'page-numbers' ? '50,95' : mode === 'sign-pdf' ? '90,95' : '50,50';
const [dx, dy] = defaultPos.split(',');
const pageHelp: Record<string, string> = {
  'merge-pdf': 'Drag files or use the arrows to set the order.',
  'organize-pdf':
    'Drag pages to reorder. Rotate or delete with the buttons on each page.',
  'split-pdf':
    'Tick the pages for “Selected pages”, or choose another split mode.',
  'remove-pages': 'Click the pages you want to remove.',
  'extract-pages': 'Click pages to unselect the ones you don’t need.',
  'jpg-to-pdf': 'Drag images to reorder. Each image becomes a page.',
  'scan-to-pdf': 'Each capture becomes a page. Drag to reorder.',
};
const uploadTitle: Record<string, string> = {
  'merge-pdf': 'Merge PDF files',
  'compare-pdf': 'Compare two PDFs',
  'jpg-to-pdf': 'Images to PDF',
  'scan-to-pdf': 'Scan to PDF',
  'unlock-pdf': 'Unlock a PDF',
  'ocr-pdf': 'Make a scanned PDF searchable',
  'protect-pdf': 'Add a password to a PDF',
};
const ocrLanguages = [
  ['eng', 'English'],
  ['spa', 'Spanish'],
  ['fra', 'French'],
  ['deu', 'German'],
  ['por', 'Portuguese'],
  ['ita', 'Italian'],
];
---

<section
  class="workspace tool-app pdf-app"
  id="pdf-tool"
  data-mode={mode}
  data-view={view}
  aria-label={tool.name}
>
  <div class="app-upload dropzone" data-drop id="pdf-upload">
    <Kitty small interactive={false} />
    <h2>{uploadTitle[mode] || tool.name}</h2>
    <p>
      {mode === 'compare-pdf'
        ? 'Choose the two PDFs you want to compare.'
        : images
          ? 'Choose images, or drop them here.'
          : multi
            ? 'Choose PDF files, or drop them here.'
            : 'Choose a PDF, or drop it here.'}
    </p>
    {mode === 'unlock-pdf' && (
      <div class="unlock-box">
        <label class="side-label" for="pdf-password">
          PDF password
        </label>
        <input
          id="pdf-password"
          type="password"
          autocomplete="off"
          placeholder="Type the password first"
        />
        <p class="side-note aadhaar-hint" id="aadhaar-hint" hidden>
          e-Aadhaar password: the first 4 letters of your name in CAPITALS +
          your year of birth. Example: <strong>RAHU1990</strong>
        </p>
      </div>
    )}
    <label class="button app-select" for="pdf-files">
      Select {images ? 'images' : multi ? 'PDF files' : 'PDF file'}{' '}
      <span aria-hidden="true">↗</span>
    </label>
    <input
      id="pdf-files"
      class="file-input"
      type="file"
      accept={images ? '.jpg,.jpeg,.png,.webp' : '.pdf'}
      multiple={multi || !images}
    />
    {mode === 'scan-to-pdf' && (
      <button
        id="camera-start"
        class="button secondary camera-button"
        type="button"
      >
        Use camera <span aria-hidden="true">📷</span>
      </button>
    )}
    <p class="file-help">
      No file-size or page limits. Nothing is uploaded.
    </p>
    {!multi && !images && (
      <div class="multi-choice" id="pdf-choice" hidden>
        <p>You chose more than one PDF. What would you like to do?</p>
        <div class="choice-actions">
          <button class="button" type="button" data-choice="merge-pdf">
            Combine into one PDF
          </button>
          <button class="button secondary" type="button" data-choice="compress-pdf">
            Compress each PDF
          </button>
        </div>
        <button class="text-link" type="button" data-choice="first">
          Use only the first PDF here
        </button>
      </div>
    )}
  </div>
  {mode === 'scan-to-pdf' && (
    <div class="camera-panel" id="camera-panel">
      <video id="scan-video" autoplay playsinline muted hidden></video>
      <div class="side-actions">
        <button id="camera-capture" class="button compact" type="button" hidden>
          Capture page
        </button>
        <button
          id="camera-stop"
          class="button secondary compact"
          type="button"
          hidden
        >
          Stop camera
        </button>
      </div>
    </div>
  )}
  <p
    id="pdf-status"
    class="local-status app-status"
    role="status"
    aria-live="polite"
  >
    100% on your device
  </p>

  <div id="pdf-editor" class="app-editor" hidden>
    <div class="app-stage">
      <div class="stage-bar" hidden={mode === 'compare-pdf'}>
        <p id="page-help" class="field-hint">
          {pageHelp[mode] || 'Click a page to preview it.'}
        </p>
        {[
          'split-pdf',
          'remove-pages',
          'extract-pages',
          'organize-pdf',
        ].includes(mode) && (
          <span class="stage-bar-actions">
            <button id="select-pages" class="text-link" type="button">
              Select all
            </button>
            <button id="clear-pages" class="text-link" type="button">
              Clear
            </button>
          </span>
        )}
      </div>
      <div
        id="pdf-pages"
        class:list={[
          'page-grid',
          {
            'page-strip': view === 'preview',
            'file-grid': mode === 'merge-pdf',
          },
        ]}
      ></div>
      <div
        class="pdf-preview-wrap"
        hidden={view !== 'preview' || mode === 'compare-pdf'}
      >
        <div class="local-preview app-preview">
          <canvas
            id="pdf-preview"
            aria-label="Page preview. Drag to place a box or drawing; exact controls are in the panel."
          ></canvas>
        </div>
        <p id="preview-caption" class="field-hint app-hint"></p>
      </div>
      <div id="compare-view" class="compare-grid"></div>
    </div>

    <aside class="app-sidebar" aria-label={`${tool.name} options`}>
      <div class="sidebar-head">
        <h2>{tool.name}</h2>
        <button id="pdf-reset" class="text-link sidebar-reset" type="button">
          Start over
        </button>
      </div>

      {['merge-pdf', 'organize-pdf', 'jpg-to-pdf', 'scan-to-pdf'].includes(
        mode,
      ) && (
        <label class="button secondary compact upload-mini" for="pdf-files">
          + Add {images ? 'images' : 'PDFs'}
        </label>
      )}

      {mode === 'merge-pdf' && (
        <p class="side-intro">
          Files are joined in the order shown. The first file comes first.
        </p>
      )}
      {mode === 'organize-pdf' && (
        <p class="side-intro">
          Unticked pages are left out. Rotations are applied when you save.
        </p>
      )}
      {mode === 'remove-pages' && (
        <p class="side-intro">
          <strong id="remove-count">0</strong> page(s) will be removed.
        </p>
      )}
      {mode === 'extract-pages' && (
        <p class="side-intro">Ticked pages are saved as a new PDF.</p>
      )}
      {mode === 'repair-pdf' && (
        <p class="side-intro">
          Rewrites a PDF that can still be read, which fixes many small
          structure problems. Badly damaged files cannot be recovered.
        </p>
      )}
      {mode === 'unlock-pdf' && (
        <p class="side-intro">
          Saves an unlocked copy. Pages are rebuilt as images, so text can no
          longer be selected.
        </p>
      )}

      {mode === 'ocr-pdf' && (
        <>
          <p class="side-intro">
            Reads the text on scanned pages and adds it as an invisible layer,
            so you can search, select and copy it. Pages look exactly the same.
          </p>
          <label class="side-label" for="ocr-language">
            Document language
          </label>
          <select id="ocr-language">
            {ocrLanguages.map(([code, name]) => (
              <option value={code}>{name}</option>
            ))}
          </select>
          <label class="toggle-row">
            <input id="ocr-skip-text" type="checkbox" checked /> Skip pages that
            already have text
          </label>
          <label class="toggle-row">
            <input id="ocr-save-text" type="checkbox" /> Also save the text
            (.txt)
          </label>
          <p class="side-note">
            The OCR engine and language model (about 3 MB each) download once
            and run in this tab. Expect a few seconds per page.
          </p>
        </>
      )}
      {mode === 'protect-pdf' && (
        <>
          <p class="side-intro">
            Encrypts the PDF with AES-256. It will ask for this password every
            time it is opened.
          </p>
          <label class="side-label" for="protect-password">
            Password
          </label>
          <div class="password-field">
            <input
              id="protect-password"
              type="password"
              autocomplete="new-password"
              minlength="6"
              maxlength="127"
              aria-describedby="protect-hint"
            />
            <button
              class="text-link password-toggle"
              type="button"
              data-reveal="protect-password protect-confirm"
              aria-pressed="false"
            >
              Show
            </button>
          </div>
          <label class="side-label" for="protect-confirm">
            Confirm password
          </label>
          <input
            id="protect-confirm"
            type="password"
            autocomplete="new-password"
            maxlength="127"
          />
          <p class="side-note" id="protect-hint">
            At least 6 characters. There is no way to recover a forgotten
            password, so keep it somewhere safe.
          </p>
          <label class="toggle-row">
            <input id="protect-restrict" type="checkbox" /> Block printing,
            copying and editing
          </label>
          <p class="side-note">
            These restrictions are honoured by most PDF readers but cannot be
            enforced everywhere. The password itself is real encryption.
          </p>
        </>
      )}
      {mode === 'split-pdf' && (
        <>
          <p class="side-label" id="split-label">
            Split mode
          </p>
          <div
            class="format-cards stack"
            role="radiogroup"
            aria-labelledby="split-label"
          >
            <label class="format-card">
              <input
                type="radio"
                name="split-chip"
                value="selection"
                data-sync="split-mode"
                checked
              />
              <span>
                <strong>Selected pages</strong>
                <small>Ticked pages become one PDF</small>
              </span>
            </label>
            <label class="format-card">
              <input
                type="radio"
                name="split-chip"
                value="every"
                data-sync="split-mode"
              />
              <span>
                <strong>Every page</strong>
                <small>One PDF per page (ZIP)</small>
              </span>
            </label>
            <label class="format-card">
              <input
                type="radio"
                name="split-chip"
                value="ranges"
                data-sync="split-mode"
              />
              <span>
                <strong>Custom ranges</strong>
                <small>For example 1-2;3-5</small>
              </span>
            </label>
          </div>
          <input type="hidden" id="split-mode" value="selection" />
          <div id="split-ranges-field" hidden>
            <label class="side-label" for="split-ranges">
              Ranges (separate with ;)
            </label>
            <input id="split-ranges" placeholder="1-2;3-5" />
          </div>
        </>
      )}

      {images && (
        <>
          <p class="side-label" id="size-label">
            Page size
          </p>
          <div
            class="chip-group"
            role="radiogroup"
            aria-labelledby="size-label"
          >
            {[
              ['a4', 'A4'],
              ['letter', 'Letter'],
              ['image', 'Same as image'],
            ].map(([v, t], i) => (
              <label class="chip">
                <input
                  type="radio"
                  name="size-chip"
                  value={v}
                  data-sync="pdf-page-size"
                  checked={i === 0}
                />
                <span>{t}</span>
              </label>
            ))}
          </div>
          <input type="hidden" id="pdf-page-size" value="a4" />
          <p class="side-label" id="orient-label">
            Orientation
          </p>
          <div
            class="chip-group"
            role="radiogroup"
            aria-labelledby="orient-label"
          >
            <label class="chip">
              <input
                type="radio"
                name="orient-chip"
                value="portrait"
                data-sync="pdf-orientation"
                checked
              />
              <span>Portrait</span>
            </label>
            <label class="chip">
              <input
                type="radio"
                name="orient-chip"
                value="landscape"
                data-sync="pdf-orientation"
              />
              <span>Landscape</span>
            </label>
          </div>
          <input type="hidden" id="pdf-orientation" value="portrait" />
          <p class="side-label" id="margin-label">
            Margin
          </p>
          <div
            class="chip-group"
            role="radiogroup"
            aria-labelledby="margin-label"
          >
            {[
              ['0', 'None'],
              ['24', 'Small'],
              ['56', 'Big'],
            ].map(([v, t], i) => (
              <label class="chip">
                <input
                  type="radio"
                  name="margin-chip"
                  value={v}
                  data-sync="pdf-margin"
                  checked={i === 1}
                />
                <span>{t}</span>
              </label>
            ))}
          </div>
          <input type="hidden" id="pdf-margin" value="24" />
          <details class="more-options">
            <summary>Fit</summary>
            <label for="pdf-fit">Image fit</label>
            <select id="pdf-fit">
              <option value="fit">Show the whole image</option>
              <option value="fill">Fill the page (crop edges)</option>
            </select>
            {mode === 'scan-to-pdf' && (
              <>
                <p class="side-note">
                  Crop the previewed scan (% of the original):
                </p>
                <div class="control-pair">
                  {['x', 'y', 'w', 'h'].map((key) => (
                    <div>
                      <label for={`scan-${key}`}>
                        {{ x: 'Left', y: 'Top', w: 'Width', h: 'Height' }[key]}
                      </label>
                      <input
                        id={`scan-${key}`}
                        type="number"
                        min="0"
                        max="100"
                        value={key === 'w' || key === 'h' ? 100 : 0}
                      />
                    </div>
                  ))}
                </div>
                <button id="scan-crop" class="text-link" type="button">
                  Apply crop to this scan
                </button>
              </>
            )}
          </details>
        </>
      )}

      {mode === 'compress-pdf' && (
        <>
          <p class="side-label" id="level-label">
            Compression level
          </p>
          <div
            class="format-cards stack"
            role="radiogroup"
            aria-labelledby="level-label"
          >
            <label class="format-card">
              <input
                type="radio"
                name="level-chip"
                value="rewrite"
                data-sync="compression-mode"
                checked
              />
              <span>
                <strong>Recommended</strong>
                <small>Keeps text and quality. Saves less.</small>
              </span>
            </label>
            <label class="format-card">
              <input
                type="radio"
                name="level-chip"
                value="raster"
                data-sync="compression-mode"
              />
              <span>
                <strong>Strong</strong>
                <small>
                  Much smaller. Pages become images; text can’t be selected.
                </small>
              </span>
            </label>
          </div>
          <input type="hidden" id="compression-mode" value="rewrite" />
          <details class="more-options" id="raster-options">
            <summary>Strong compression settings</summary>
            <label for="pdf-resolution">
              Page resolution (longest side, px)
            </label>
            <input
              id="pdf-resolution"
              type="number"
              min="600"
              max="2400"
              value="1400"
            />
            <label for="pdf-quality">
              Image quality <output id="pdf-quality-value">75%</output>
            </label>
            <input
              id="pdf-quality"
              type="range"
              min="40"
              max="95"
              value="75"
              data-show="pdf-quality-value"
              data-suffix="%"
            />
          </details>
        </>
      )}

      {mode === 'rotate-pdf' && (
        <>
          <p class="side-label">Rotate pages</p>
          <div class="rotate-buttons">
            {[
              ['90', '↻', 'Right'],
              ['180', '⟲', '180°'],
              ['270', '↺', 'Left'],
            ].map(([v, icon, t], i) => (
              <label class="rotate-choice">
                <input
                  type="radio"
                  name="angle-chip"
                  value={v}
                  data-sync="pdf-angle"
                  checked={i === 0}
                />
                <span class="rotate-btn">
                  <span aria-hidden="true">{icon}</span> {t}
                </span>
              </label>
            ))}
          </div>
          <input type="hidden" id="pdf-angle" value="90" />
        </>
      )}

      {mode === 'pdf-to-text' && (
        <>
          <p class="side-label" id="text-format-label">
            Save as
          </p>
          <div
            class="chip-group"
            role="radiogroup"
            aria-labelledby="text-format-label"
          >
            <label class="chip">
              <input
                type="radio"
                name="text-format-chip"
                value="txt"
                data-sync="text-format"
                checked
              />
              <span>Plain text (.txt)</span>
            </label>
            <label class="chip">
              <input
                type="radio"
                name="text-format-chip"
                value="md"
                data-sync="text-format"
              />
              <span>Markdown (.md)</span>
            </label>
          </div>
          <input type="hidden" id="text-format" value="txt" />
          <p class="side-note">
            Only selectable text is extracted. Scanned pages may come out empty.
          </p>
        </>
      )}

      {mode === 'sign-pdf' && (
        <>
          <div class="side-tabs" role="tablist" aria-label="Signature type">
            <button
              type="button"
              role="tab"
              id="tab-draw"
              aria-selected="true"
              aria-controls="panel-draw"
              data-tab="draw"
            >
              Draw
            </button>
            <button
              type="button"
              role="tab"
              id="tab-type"
              aria-selected="false"
              aria-controls="panel-type"
              tabindex="-1"
              data-tab="type"
            >
              Type
            </button>
            <button
              type="button"
              role="tab"
              id="tab-upload"
              aria-selected="false"
              aria-controls="panel-upload"
              tabindex="-1"
              data-tab="upload"
            >
              Upload
            </button>
          </div>
          <div
            class="side-panel"
            role="tabpanel"
            id="panel-draw"
            aria-labelledby="tab-draw"
          >
            <canvas
              id="signature-pad"
              class="signature-pad"
              width="600"
              height="220"
              aria-label="Draw your signature with a mouse, finger or stylus"
            ></canvas>
            <div class="side-actions">
              <button
                id="signature-clear"
                class="button secondary compact"
                type="button"
              >
                Clear
              </button>
            </div>
          </div>
          <div
            class="side-panel"
            role="tabpanel"
            id="panel-type"
            aria-labelledby="tab-type"
            hidden
          >
            <label class="side-label" for="pdf-text">
              Your name
            </label>
            <input id="pdf-text" maxlength="80" placeholder="Type your name" />
            <p class="side-note">Shown in a handwriting-style font.</p>
          </div>
          <div
            class="side-panel"
            role="tabpanel"
            id="panel-upload"
            aria-labelledby="tab-upload"
            hidden
          >
            <label
              class="button secondary compact upload-mini"
              for="pdf-overlay"
            >
              Choose signature image
            </label>
            <input
              id="pdf-overlay"
              class="file-input"
              type="file"
              accept=".png,.jpg,.jpeg"
            />
            <p class="side-note" id="overlay-name">
              PNG with a transparent background looks best.
            </p>
          </div>
          <label class="side-label" for="pdf-scale">
            Signature size <output id="pdf-scale-value">30%</output>
          </label>
          <input
            id="pdf-scale"
            type="range"
            min="5"
            max="90"
            value="30"
            data-show="pdf-scale-value"
            data-suffix="%"
          />
          <p class="side-note">
            Click the page preview to place it. This is a visual signature, not
            a digital certificate.
          </p>
        </>
      )}

      {mode === 'edit-pdf' && (
        <div class="side-tabs" role="tablist" aria-label="Edit tools">
          <button
            type="button"
            role="tab"
            id="tab-text"
            aria-selected="true"
            aria-controls="panel-text"
            data-tab="text"
          >
            Text
          </button>
          <button
            type="button"
            role="tab"
            id="tab-image"
            aria-selected="false"
            aria-controls="panel-image"
            tabindex="-1"
            data-tab="image"
          >
            Image
          </button>
          <button
            type="button"
            role="tab"
            id="tab-draw"
            aria-selected="false"
            aria-controls="panel-draw"
            tabindex="-1"
            data-tab="draw"
          >
            Draw
          </button>
        </div>
      )}

      {['watermark-pdf'].includes(mode) && (
        <div class="side-tabs" role="tablist" aria-label="Watermark type">
          <button
            type="button"
            role="tab"
            id="tab-text"
            aria-selected="true"
            aria-controls="panel-text"
            data-tab="text"
          >
            Text
          </button>
          <button
            type="button"
            role="tab"
            id="tab-image"
            aria-selected="false"
            aria-controls="panel-image"
            tabindex="-1"
            data-tab="image"
          >
            Image
          </button>
        </div>
      )}

      {['watermark-pdf', 'edit-pdf'].includes(mode) && (
        <>
          <div
            class="side-panel"
            role="tabpanel"
            id="panel-text"
            aria-labelledby="tab-text"
          >
            <label class="side-label" for="pdf-text">
              {mode === 'watermark-pdf' ? 'Watermark text' : 'Text to add'}
            </label>
            <input
              id="pdf-text"
              maxlength="200"
              placeholder={
                mode === 'watermark-pdf' ? 'CONFIDENTIAL' : 'Type something'
              }
            />
            <div class="control-pair">
              <div>
                <label class="side-label" for="pdf-color">
                  Colour
                </label>
                <input
                  id="pdf-color"
                  type="color"
                  value={mode === 'watermark-pdf' ? '#c0392b' : '#111111'}
                  class="color-input"
                />
              </div>
              <div>
                <label class="side-label" for="pdf-font-size">
                  Size (pt)
                </label>
                <input
                  id="pdf-font-size"
                  type="number"
                  min="6"
                  max="144"
                  value={mode === 'watermark-pdf' ? 48 : 18}
                />
              </div>
            </div>
            {mode === 'watermark-pdf' && (
              <>
                <label class="side-label" for="pdf-rotation">
                  Rotation <output id="pdf-rotation-value">45°</output>
                </label>
                <input
                  id="pdf-rotation"
                  type="range"
                  min="-90"
                  max="90"
                  value="45"
                  data-show="pdf-rotation-value"
                  data-suffix="°"
                />
              </>
            )}
          </div>
          <div
            class="side-panel"
            role="tabpanel"
            id="panel-image"
            aria-labelledby="tab-image"
            hidden
          >
            <label
              class="button secondary compact upload-mini"
              for="pdf-overlay"
            >
              Choose image (PNG/JPG)
            </label>
            <input
              id="pdf-overlay"
              class="file-input"
              type="file"
              accept=".png,.jpg,.jpeg"
            />
            <p class="side-note" id="overlay-name">
              No image chosen.
            </p>
            <label class="side-label" for="pdf-scale">
              Image size <output id="pdf-scale-value">30%</output>
            </label>
            <input
              id="pdf-scale"
              type="range"
              min="5"
              max="90"
              value="30"
              data-show="pdf-scale-value"
              data-suffix="%"
            />
          </div>
        </>
      )}

      {mode === 'edit-pdf' && (
        <div
          class="side-panel"
          role="tabpanel"
          id="panel-draw"
          aria-labelledby="tab-draw"
          hidden
        >
          <p class="side-label" id="draw-label">
            Draw on the page
          </p>
          <div
            class="chip-group"
            role="radiogroup"
            aria-labelledby="draw-label"
          >
            <label class="chip">
              <input
                type="radio"
                name="draw-chip"
                value="rect"
                data-sync="annotation-mode"
                checked
              />
              <span>▭ Box</span>
            </label>
            <label class="chip">
              <input
                type="radio"
                name="draw-chip"
                value="pen"
                data-sync="annotation-mode"
              />
              <span>✎ Pen</span>
            </label>
          </div>
          <input type="hidden" id="annotation-mode" value="rect" />
          <div class="side-actions">
            <button
              id="undo-shape"
              class="button secondary compact"
              type="button"
            >
              Undo
            </button>
            <button
              id="clear-shapes"
              class="button secondary compact"
              type="button"
            >
              Clear all
            </button>
          </div>
          <details class="more-options">
            <summary>Exact box</summary>
            <div class="control-pair">
              {['x', 'y', 'w', 'h'].map((key) => (
                <div>
                  <label for={`pdf-rect-${key}`}>
                    {
                      { x: 'Left %', y: 'Top %', w: 'Width %', h: 'Height %' }[
                        key
                      ]
                    }
                  </label>
                  <input
                    id={`pdf-rect-${key}`}
                    type="number"
                    min="0"
                    max="100"
                    value={key === 'w' || key === 'h' ? 50 : 0}
                  />
                </div>
              ))}
            </div>
            <button id="add-shape" class="text-link" type="button">
              Add this box
            </button>
          </details>
        </div>
      )}

      {mode === 'page-numbers' && (
        <>
          <div class="control-pair">
            <div>
              <label class="side-label" for="number-start">
                First number
              </label>
              <input
                id="number-start"
                type="number"
                min="1"
                max="99999"
                value="1"
              />
            </div>
            <div>
              <label class="side-label" for="pdf-font-size">
                Size (pt)
              </label>
              <input
                id="pdf-font-size"
                type="number"
                min="6"
                max="72"
                value="12"
              />
            </div>
          </div>
          <label class="side-label" for="number-format">
            Style
          </label>
          <select id="number-format">
            <option value="{n}">1, 2, 3</option>
            <option value="{n} / {total}" selected>
              1 / 10
            </option>
            <option value="Page {n}">Page 1</option>
            <option value="Page {n} of {total}">Page 1 of 10</option>
            <option value="- {n} -">- 1 -</option>
          </select>
        </>
      )}

      {placement && (
        <div
          class={mode === 'edit-pdf' ? 'side-extra' : ''}
          data-extra-for={mode === 'edit-pdf' ? 'text image' : undefined}
        >
          <p class="side-label" id="pdf-pos-label">
            Position
          </p>
          <div
            class="position-grid"
            role="radiogroup"
            aria-labelledby="pdf-pos-label"
          >
            {positions.map(([x, y, name]) => (
              <label class="pos-cell" title={String(name)}>
                <input
                  type="radio"
                  name="pdf-position"
                  value={`${x},${y}`}
                  data-pdf-position
                  checked={`${x},${y}` === defaultPos}
                />
                <span></span>
                <span class="sr-only">{name}</span>
              </label>
            ))}
          </div>
          {mode !== 'page-numbers' && (
            <>
              <label class="side-label" for="pdf-opacity">
                Transparency{' '}
                <output id="pdf-opacity-value">
                  {mode === 'watermark-pdf' ? '35%' : '100%'}
                </output>
              </label>
              <input
                id="pdf-opacity"
                type="range"
                min="5"
                max="100"
                value={mode === 'watermark-pdf' ? 35 : 100}
                data-show="pdf-opacity-value"
                data-suffix="%"
              />
            </>
          )}
          <details class="more-options">
            <summary>Exact position</summary>
            <div class="control-pair">
              <div>
                <label for="pdf-x">Across (%)</label>
                <input id="pdf-x" type="number" min="0" max="100" value={dx} />
              </div>
              <div>
                <label for="pdf-y">Down (%)</label>
                <input id="pdf-y" type="number" min="0" max="100" value={dy} />
              </div>
            </div>
          </details>
        </div>
      )}

      {['crop-pdf', 'redact-pdf'].includes(mode) && (
        <>
          <p class="side-intro">
            {mode === 'crop-pdf'
              ? 'Drag on the page to draw the area to keep.'
              : 'Drag on the page over anything you want to black out, then press “Black out this area”.'}
          </p>
          {mode === 'redact-pdf' && (
            <>
              <div class="side-actions">
                <button id="add-redaction" class="button compact" type="button">
                  Black out this area
                </button>
                <button
                  id="clear-redactions"
                  class="button secondary compact"
                  type="button"
                >
                  Clear all
                </button>
              </div>
              <p class="side-note">
                Every page is rebuilt as an image so hidden text can’t be
                recovered. Links and forms are removed. Check every page.
              </p>
            </>
          )}
          {mode === 'crop-pdf' && (
            <p class="side-note">
              Cropping hides the outside area; it doesn’t delete it. Use Redact
              PDF to remove content.
            </p>
          )}
          <details class="more-options">
            <summary>Exact area (% of page)</summary>
            <div class="control-pair">
              {['x', 'y', 'w', 'h'].map((key) => (
                <div>
                  <label for={`pdf-rect-${key}`}>
                    {{ x: 'Left', y: 'Top', w: 'Width', h: 'Height' }[key]}
                  </label>
                  <input
                    id={`pdf-rect-${key}`}
                    type="number"
                    min="0"
                    max="100"
                    value={
                      key === 'w' || key === 'h'
                        ? mode === 'crop-pdf'
                          ? 80
                          : 30
                        : mode === 'crop-pdf'
                          ? 10
                          : 20
                    }
                  />
                </div>
              ))}
            </div>
          </details>
        </>
      )}

      {mode === 'pdf-forms' && <div id="pdf-fields" class="form-fields"></div>}

      {mode === 'compare-pdf' && (
        <>
          <label class="side-label" for="compare-page">
            Page to compare
          </label>
          <input id="compare-page" type="number" min="1" value="1" />
          <button
            id="compare-run"
            class="button secondary compact upload-mini"
            type="button"
          >
            Compare this page
          </button>
          <p class="side-note">
            Red marks show what looks different. Text differences are
            approximate.
          </p>
          <pre id="compare-text" class="compare-text"></pre>
        </>
      )}

      {rangeModes.includes(mode) && (
        <details class="more-options">
          <summary>Pages</summary>
          <label for="pdf-range">Only these pages (blank = all)</label>
          <input id="pdf-range" placeholder="e.g. 1,3-5" />
        </details>
      )}

      {mode === 'ocr-pdf' && (
        <div class="engine-progress" id="pdf-progress-wrap" hidden>
          <progress id="pdf-progress" max="100" value="0"></progress>
          <button
            id="pdf-cancel"
            class="button secondary compact"
            type="button"
          >
            Cancel
          </button>
        </div>
      )}
      <button id="pdf-export" class="button app-primary" type="button">
        {mode === 'compare-pdf' ? 'Download report' : meta.action}{' '}
        <span aria-hidden="true">→</span>
      </button>
    </aside>
  </div>

  <ToolResult prefix="pdf" tool={tool}>
    <div class="result-next" id="pdf-next" slot="next" hidden>
      <button class="button secondary compact" type="button" data-next="compress-pdf" hidden>
        Compress this PDF <span aria-hidden="true">→</span>
      </button>
      <button class="button secondary compact" type="button" data-next="merge-pdf" hidden>
        Combine into one PDF <span aria-hidden="true">→</span>
      </button>
    </div>
  </ToolResult>
</section>
<script src="../scripts/pdf-tool.ts"></script>
