---
const { small = false, interactive = true, pose = 'sit' } = Astro.props;
const guard = pose === 'guard';
---

<div class:list={['kitty', { 'kitty-small': small }]} data-kitty data-state="idle" data-pose={pose}>
  <svg viewBox="0 0 400 400" aria-hidden="true" class="kitty-art">
    <g class="kitty-body">
      <path class="loki-tail" d="M266 322C316 330 343 300 333 264C327 242 304 240 298 258" fill="none" stroke-width="25" stroke-linecap="round" />
      <path class="loki-fur" d="M163 200C132 226 117 266 121 300C125 332 158 346 200 346C242 346 275 332 279 300C283 266 268 226 237 200Z" />
      <path class="kitty-belly" d="M148 304C146 264 172 234 206 234C232 234 250 250 254 272C239 259 220 254 203 258C181 263 166 282 163 308C159 318 149 315 148 304Z" />
      <ellipse class="kitty-belly kitty-sock" cx="177" cy="339" rx="16" ry="9" />
      <ellipse class="kitty-belly kitty-sock" cx="223" cy="339" rx="16" ry="9" />
      <g class="kitty-head">
        <path class="loki-fur" d="M127 160C123 122 127 92 136 66Q142 49 154 60L180 87C193 82 207 82 220 87L246 60Q258 49 264 66C273 92 277 122 273 160C269 200 238 220 200 220C162 220 131 200 127 160Z" />
        <g class="kitty-ear kitty-ear-left"><path class="kitty-inner-ear" d="M146 74Q148 65 155 72L170 89Q156 96 148 108Q144 90 146 74Z" /></g>
        <g class="kitty-ear kitty-ear-right"><path class="kitty-inner-ear" d="M254 74Q252 65 245 72L230 89Q244 96 252 108Q256 90 254 74Z" /></g>
        <path class="kitty-face" d="M141 151C139 117 151 99 168 102C181 104 191 110 200 119C209 110 219 104 232 102C249 99 261 117 259 151C257 188 232 207 200 207C168 207 143 188 141 151Z" />
        <ellipse class="kitty-blush" cx="160" cy="180" rx="10" ry="5.5" />
        <ellipse class="kitty-blush" cx="240" cy="180" rx="10" ry="5.5" />
        <g class="kitty-eyes">
          <g class="kitty-gaze">
            <ellipse cx="173" cy="153" rx="13" ry={guard ? 14 : 18} transform="rotate(-6 173 153)" />
            <ellipse cx="227" cy="153" rx="13" ry={guard ? 14 : 18} transform="rotate(6 227 153)" />
            <circle class="kitty-glint" cx="177.5" cy="145.5" r="4.6" />
            <circle class="kitty-glint" cx="231.5" cy="145.5" r="4.6" />
            <circle class="kitty-glint" cx="169" cy="160" r="2" />
            <circle class="kitty-glint" cx="223" cy="160" r="2" />
          </g>
        </g>
        <g class="kitty-happy">
          <path d="M160 156Q173 141 186 156M214 156Q227 141 240 156" fill="none" stroke-width="5" stroke-linecap="round" />
        </g>
        <path class="kitty-nose" d="M194 173Q200 168 206 173Q204 179 200 180Q196 179 194 173Z" />
        <path class="kitty-mouth" d="M189 184Q194.5 190 200 184Q205.5 190 211 184" fill="none" stroke-width="2.6" stroke-linecap="round" />
      </g>
    </g>
    <g class="kitty-sparkles"><path d="M318 96l4 12 12 4-12 4-4 12-4-12-12-4 12-4z" /><path d="M88 128l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" /></g>
  </svg>
  {interactive && <button class="kitty-pet" aria-label="Say hello to Loki" title="Say hello to Loki"></button>}
</div>
