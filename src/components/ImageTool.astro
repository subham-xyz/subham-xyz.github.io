---
import ToolLayout from '../layouts/ToolLayout.astro';
import UploadArea from './UploadArea.astro';
import Kitty from './Kitty.astro';
import ImageSettings from './ImageSettings.astro';
import BatchCompressor from './BatchCompressor.astro';
const { mode = 'converter', titleOverride, descriptionOverride, target = 0, exam = false } = Astro.props;
const title = titleOverride || (mode === 'compressor' ? 'Image compressor' : mode === 'resizer' ? 'Image resizer' : 'Image converter');
const description = descriptionOverride || (mode === 'compressor' ? 'Compress images to a target size with measured results. Private, local JPG, PNG, WebP and supported AVIF processing.' : mode === 'resizer' ? 'Resize images by pixels or percentage. Prepare photos, signatures and social images locally, with no uploads.' : 'Same image. A fresh format. Convert JPG, PNG, WebP, BMP, GIF still frames and supported AVIF locally.');
---
<ToolLayout title={title} description={description}>
<noscript><p class="noscript">This tool needs JavaScript to convert images locally. Enable it in your browser and reload to get started.</p></noscript>
<section class="workspace" id="converter" data-mode={mode} data-target={target} data-exam={exam} aria-label={title}><div class="workspace-top"><div class="workflow" aria-label="Conversion steps"><span data-step="upload" class="active">01 Select</span><span data-step="editor">02 Convert</span><span data-step="result">03 Download</span></div><span class="tool-badge">● Private by design</span></div><p id="tool-status" class="sr-only" role="status" aria-live="polite"></p>
<UploadArea extended />
<div id="editor-panel" class="state-panel" hidden><div class="editor-grid"><div class="preview-wrap"><img id="input-preview" alt="Selected image preview" /></div><div><h2 id="file-name" class="file-name"></h2><p id="file-meta" class="file-meta"></p><label class="field-label" for="output-name">Save file as</label><div class="filename-control"><input id="output-name" type="text" maxlength="100" autocomplete="off" spellcheck="false" aria-describedby="filename-help" /><span id="file-extension">.webp</span></div><p id="filename-help" class="field-hint">Choose a name. We add the correct file extension.</p><ImageSettings mode={mode} /><label class="field-label" for="output-format">Convert to</label><select id="output-format"><option value="image/webp">WebP — smaller, web-friendly</option><option value="image/jpeg">JPG — widely compatible</option><option value="image/png">PNG — lossless, transparent</option><option value="image/avif">AVIF - when supported</option></select><label class="check-label"><input id="transparent-background" type="checkbox" checked /> Preserve transparency (PNG, WebP, supported AVIF)</label><label class="field-label" for="background">Solid / JPEG background</label><input id="background" type="color" value="#ffffff" /><div id="quality-field"><label class="field-label" for="quality">Quality <output id="quality-value" for="quality">85%</output></label><input type="range" id="quality" min="10" max="100" value="85" step="1" /><p class="field-hint">Higher quality can mean a larger file.</p></div><p class="field-hint mt-4" id="format-hint">Transparency is preserved. Animated inputs become a still image.</p><p id="settings-error" role="alert" tabindex="-1"></p><div class="editor-actions"><button id="convert" class="button">{mode === 'compressor' ? 'Compress image' : mode === 'resizer' ? 'Resize image' : 'Convert image'} <span aria-hidden="true">↗</span></button><button class="text-link" data-reset>Choose another</button></div></div></div></div>
<div id="processing-panel" class="state-panel processing-panel" hidden><Kitty small interactive={false} /><span class="spinner" aria-hidden="true"></span><h2>A little format magic…</h2><p>Loki is working on your image, right here on your device.</p></div>
<div id="result-panel" class="state-panel result-panel" hidden><Kitty small interactive={false} /><h2 tabindex="-1" id="result-title">{mode === 'compressor' ? 'All done. Size checked.' : mode === 'resizer' ? 'All done. Resized.' : 'All done. Nicely converted.'}</h2><p>Your image is ready for its next adventure.</p><div class="preview-wrap"><img id="output-preview" alt="Converted image preview" /></div><div id="result-meta" class="result-meta"></div><a id="download" class="button" download>Download image <span aria-hidden="true">↓</span></a><p id="constraint-results" role="status"></p><div><button class="text-link mt-3" id="back-settings">Return to settings</button></div><div><button class="text-link mt-3" data-reset>Convert another image ↗</button></div></div>
<div id="error-panel" class="state-panel error-panel" hidden><Kitty small interactive={false} /><h2 tabindex="-1" id="error-title">A little snag.</h2><p id="error-message" class="error-message"></p><button class="button" data-reset>Try another image <span aria-hidden="true">↗</span></button></div>
</section>
{mode==='compressor'&&<BatchCompressor/>}
<script src="../scripts/converter.ts"></script>
</ToolLayout>