---
import { localeFromPath } from '../i18n/config';
import { translator } from '../i18n';
const tr = translator(localeFromPath(Astro.url.pathname));
import ToolLayout from '../layouts/ToolLayout.astro';
import UploadArea from './UploadArea.astro';
import Kitty from './Kitty.astro';
import ImageSettings from './ImageSettings.astro';
import BatchCompressor from './BatchCompressor.astro';
import RelatedTools from './RelatedTools.astro';
const { mode = 'converter', titleOverride, descriptionOverride, target = 0, exam = false } = Astro.props;
const toolId = mode === 'compressor' ? 'image-compressor' : mode === 'resizer' ? 'image-resizer' : 'image-converter';
const name = mode === 'compressor' ? tr('compressor.title') : mode === 'resizer' ? tr('resizer.title') : tr('converter.title');
const title = titleOverride || name;
const description =
  descriptionOverride ||
  (mode === 'compressor'
    ? 'Compress JPG, PNG and WebP images to the exact size you need — 20 KB, 50 KB, 100 KB or any limit. Measured results, no uploads.'
    : mode === 'resizer'
      ? 'Resize images by pixels or percentage. Ready-made sizes for exam photos, signatures and social posts, all on your device.'
      : tr('converter.description'));
const action = mode === 'compressor' ? tr('compressor.action') : mode === 'resizer' ? tr('resizer.action') : tr('converter.action');
const done = mode === 'compressor' ? tr('compressor.done') : mode === 'resizer' ? tr('resizer.done') : tr('converter.done');
---

<ToolLayout title={title} description={description}>
  <noscript><p class="noscript" data-i18n="converter.noscript">{tr('converter.noscript')}</p></noscript>
  <section class="workspace tool-app" id="converter" data-mode={mode} data-target={target} data-exam={exam} aria-label={title}>
    <div class="workflow sr-only" aria-hidden="true"><span data-step="upload" class="active" data-i18n="converter.selectStep">{tr('converter.selectStep')}</span><span data-step="editor" data-i18n="converter.adjustStep">{tr('converter.adjustStep')}</span><span data-step="result" data-i18n="converter.downloadStep">{tr('converter.downloadStep')}</span></div>
    <p id="tool-status" class="sr-only" role="status" aria-live="polite"></p>
    <UploadArea extended mode={mode} />

    <div id="editor-panel" class="state-panel" hidden>
      <div class="app-editor">
        <div class="app-stage">
          <div class="preview-wrap app-preview"><img id="input-preview" alt={tr('common.preview')} /></div>
          <p class="app-hint"><strong id="file-name" class="file-name"></strong> <span id="file-meta" class="file-meta"></span></p>
        </div>
        <aside class="app-sidebar" aria-label={tr('converter.optionsLabel', { tool: name })}>
          <div class="sidebar-head"><h2 data-i18n={`${mode}.title`}>{name}</h2><button class="text-link sidebar-reset" type="button" data-reset data-i18n="common.reset">{tr('common.reset')}</button></div>
          <ImageSettings mode={mode} />
          <label class="side-label" for="output-format" data-i18n={mode === 'converter' ? 'converter.convertTo' : 'converter.saveAs'}>{mode === 'converter' ? tr('converter.convertTo') : tr('converter.saveAs')}</label>
          <select id="output-format">
            <option value="image/webp" data-i18n="converter.webp">{tr('converter.webp')}</option>
            <option value="image/jpeg" data-i18n="converter.jpg">{tr('converter.jpg')}</option>
            <option value="image/png" data-i18n="converter.png">{tr('converter.png')}</option>
            <option value="image/avif" data-i18n="converter.avif">{tr('converter.avif')}</option>
          </select>
          <div id="quality-field" class:list={{ 'in-more': mode !== 'converter' }}>
            <label class="side-label" for="quality"><span data-i18n="common.quality">{tr('common.quality')}</span><output id="quality-value" for="quality">85%</output></label>
            <input type="range" id="quality" min="10" max="100" value="85" step="1" />
            <p class="side-note" data-i18n="converter.qualityNote">{tr('converter.qualityNote')}</p>
          </div>
          <details class="more-options">
            <summary data-i18n={mode === 'converter' ? 'common.options' : 'converter.fileOptions'}>{mode === 'converter' ? tr('common.options') : tr('converter.fileOptions')}</summary>
            <label for="output-name" data-i18n="converter.filename">{tr('converter.filename')}</label>
            <div class="filename-control"><input id="output-name" type="text" maxlength="100" autocomplete="off" spellcheck="false" aria-describedby="filename-help" /><span id="file-extension">.webp</span></div>
            <p id="filename-help" class="side-note" data-i18n="converter.extension">{tr('converter.extension')}</p>
            <label class="toggle-row"><input id="transparent-background" type="checkbox" checked /><span data-i18n="converter.transparency">{tr('converter.transparency')}</span></label>
            <label for="background" data-i18n="converter.background">{tr('converter.background')}</label>
            <input id="background" type="color" value="#ffffff" class="color-input" />
            <p class="side-note" id="format-hint">{tr('converter.formatHint')}</p>
          </details>
          <p id="settings-error" role="alert" tabindex="-1"></p>
          <button id="convert" class="button app-primary" type="button"><span data-i18n={`${mode}.action`}>{action}</span> <span aria-hidden="true">→</span></button>
        </aside>
      </div>
    </div>

    <div id="processing-panel" class="state-panel processing-panel" hidden>
      <Kitty small interactive={false} /><span class="spinner" aria-hidden="true"></span>
      <h2 data-i18n="common.processing">{tr('common.processing')}</h2><p data-i18n="converter.processingNote">{tr('converter.processingNote')}</p>
    </div>

    <div id="result-panel" class="state-panel app-result" hidden>
      <div class="result-top">
        <button class="result-back" id="back-settings" type="button" aria-label={tr('common.back')} data-i18n-aria-label="common.back" title={tr('common.back')} data-i18n-title="common.back">←</button>
        <div class="result-main">
          <div class="result-kitty"><Kitty small interactive={false} /></div>
          <h2 tabindex="-1" id="result-title" data-i18n={`${mode}.done`}>{done}</h2>
          <a id="download" class="button result-download" download>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14" /></svg><span data-i18n="common.download">{tr('common.download')}</span></a>
          <div id="result-ring" class="result-stats" hidden>
            <div class="saving-ring" id="ring" style="--p:0"><span><strong id="ring-value">0%</strong><small data-i18n="common.saved">{tr('common.saved')}</small></span></div>
            <p id="ring-text"></p>
          </div>
          <div class="preview-wrap result-preview"><img id="output-preview" alt={tr('common.resultPreview')} /></div>
          <div id="result-meta" class="result-meta"></div>
          <p id="constraint-results" role="status"></p>
          <button class="text-link result-again" type="button" data-reset><span data-i18n="common.newImage">{tr('common.newImage')}</span><span aria-hidden="true">↺</span></button>
        </div>
      </div>
      <RelatedTools id={toolId} title={tr('common.continue')} data-i18n-title="common.continue" count={6} headingLevel={3} />
    </div>

    <div id="error-panel" class="state-panel error-panel" hidden>
      <Kitty small interactive={false} />
      <h2 tabindex="-1" id="error-title" data-i18n="common.error">{tr('common.error')}</h2>
      <p id="error-message" class="error-message"></p>
      <button class="button" type="button" data-reset><span data-i18n="common.retry">{tr('common.retry')}</span><span aria-hidden="true">↗</span></button>
    </div>
  </section>
  {mode === 'compressor' && <BatchCompressor />}
  <script src="../scripts/converter.ts"></script>
</ToolLayout>
