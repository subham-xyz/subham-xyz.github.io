---
// Local AI image tools: Remove Background (IS-Net) and Upscale (Real-ESRGAN).
// The page is plain HTML; the AI engine loads only after the user starts processing.
import Kitty from './Kitty.astro';
const { tool } = Astro.props;
const mode: 'remove-background' | 'upscale' = tool.id;
const upscale = mode === 'upscale';
---

<section
  class="workspace tool-app bg-app"
  id="ai-tool"
  data-mode={mode}
  aria-label={tool.name}
>
  <div class="app-upload dropzone" data-drop id="ai-upload">
    <Kitty small interactive={false} />
    <h2>{upscale ? 'Upscale an image' : 'Remove an image background'}</h2>
    <p>Choose a photo, or drop it here.</p>
    <label class="button app-select" for="ai-file">
      Select image <span aria-hidden="true">↗</span>
    </label>
    <input id="ai-file" class="file-input" type="file" accept=".jpg,.jpeg,.png,.webp" />
    <p class="file-help">
      {upscale
        ? 'JPG, PNG or WebP · up to 1 megapixel (e.g. 1200 × 800) · nothing is uploaded'
        : 'JPG, PNG or WebP · up to 30 MB · nothing is uploaded'}
    </p>
    <p class="engine-notice" id="ai-device" hidden></p>
  </div>
  <p id="ai-status" class="local-status app-status" role="status" aria-live="polite">
    Runs locally on your device
  </p>

  <div id="ai-editor" class="app-editor" hidden>
    <div class="app-stage">
      <div class="bg-compare">
        <figure>
          <figcaption>Before</figcaption>
          <div class="local-preview app-preview bg-plain"><img id="ai-before" alt="Original image" /></div>
        </figure>
        <figure>
          <figcaption>After</figcaption>
          <div class:list={['local-preview app-preview', { 'bg-plain': upscale }]} id="ai-after-wrap">
            <img id="ai-after" alt={upscale ? 'Upscaled image' : 'Image with the background removed'} hidden />
            <p class="field-hint" id="ai-after-empty">The result appears here.</p>
          </div>
        </figure>
      </div>
      <p class="field-hint app-hint" id="ai-dimensions"></p>
    </div>

    <aside class="app-sidebar" aria-label={`${tool.name} options`}>
      <div class="sidebar-head">
        <h2>{tool.name}</h2>
        <button id="ai-reset" class="text-link sidebar-reset" type="button">Start over</button>
      </div>
      {upscale ? (
        <>
          <p class="side-intro">
            An AI model (Real-ESRGAN) redraws the image at a higher resolution, sharpening edges and
            cleaning up compression blocks. It runs in this browser tab.
          </p>
          <p class="side-label" id="ai-scale-label">Enlarge by</p>
          <div class="format-cards stack" role="radiogroup" aria-labelledby="ai-scale-label">
            <label class="format-card">
              <input type="radio" name="ai-scale" value="2" checked />
              <span><strong>2×</strong><small>Twice the width and height</small></span>
            </label>
            <label class="format-card">
              <input type="radio" name="ai-scale" value="4" />
              <span><strong>4×</strong><small>Four times the width and height</small></span>
            </label>
          </div>
          <label class="side-label" for="ai-format">Save as</label>
          <select id="ai-format">
            <option value="image/png">PNG (lossless)</option>
            <option value="image/jpeg">JPG (smaller file)</option>
          </select>
        </>
      ) : (
        <>
          <p class="side-intro">
            An AI model finds the main subject and makes everything else transparent. It runs in
            this browser tab.
          </p>
          <p class="side-label" id="ai-fill-label">Background</p>
          <div class="format-cards stack" role="radiogroup" aria-labelledby="ai-fill-label">
            <label class="format-card">
              <input type="radio" name="ai-fill" value="transparent" checked />
              <span><strong>Transparent</strong><small>PNG with no background</small></span>
            </label>
            <label class="format-card">
              <input type="radio" name="ai-fill" value="#ffffff" />
              <span><strong>White</strong><small>For ID photos and product shots</small></span>
            </label>
            <label class="format-card">
              <input type="radio" name="ai-fill" value="custom" />
              <span><strong>Colour</strong><small>Pick any colour</small></span>
            </label>
          </div>
          <label class="side-label" for="ai-color" id="ai-color-row" hidden>
            Colour <input id="ai-color" type="color" value="#2f7d6f" />
          </label>
        </>
      )}
      <p class="side-note" id="ai-model">
        {upscale
          ? 'The AI model (about 5 MB) downloads once and is kept on this device.'
          : 'The AI model (about 90 MB) downloads once and is kept on this device for next time.'}
      </p>
      <p class="engine-notice" id="ai-device-note" hidden></p>
      <div class="engine-progress" id="ai-progress-wrap" hidden>
        <progress id="ai-progress" max="100" value="0"></progress>
        <button id="ai-cancel" class="button secondary compact" type="button">Cancel</button>
      </div>
      <button id="ai-run" class="button app-primary" type="button">
        {upscale ? 'Upscale image' : 'Remove background'} <span aria-hidden="true">→</span>
      </button>
      <a id="ai-download" class="button app-primary" hidden download>
        Download <span aria-hidden="true">↓</span>
      </a>
    </aside>
  </div>
</section>
<script src="../scripts/ai-image-tool.ts"></script>
