---
import Logo from './Logo.astro';
import {categories} from '../data/tools';
---
<header class="site-header"><div class="shell flex items-center justify-between gap-4">
<a href="/" aria-label="KittySuite home"><Logo /></a>
<nav class="desktop-nav flex items-center gap-8" aria-label="Main navigation"><a href="/#tools">Explore tools</a>{categories.map(category=><a href={`/${category.toLowerCase()}/`}>{category}</a>)}<a href="/#how-it-works">How it works</a><a href="/privacy/">Privacy</a></nav>
<div class="flex items-center gap-3"><button id="theme-toggle" class="icon-button" aria-label="Switch color theme" title="Switch color theme"><span aria-hidden="true">◐</span></button><a class="button compact header-cta" href="/tools/image-converter/">Meet your tools <span aria-hidden="true">↗</span></a><button id="menu-toggle" class="icon-button mobile-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav"><span aria-hidden="true">☰</span></button></div>
</div><nav id="mobile-nav" aria-label="Mobile navigation" hidden><a href="/#tools">Explore tools</a>{categories.map(category=><a href={`/${category.toLowerCase()}/`}>{category}</a>)}<a href="/#how-it-works">How it works</a><a href="/privacy/">Privacy</a></nav></header>
