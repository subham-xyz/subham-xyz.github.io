---
const steps = [
 { id:'select', title:'Pick an image.', detail:'Choose a JPG, PNG, or WebP. It stays on your device.', tip:'A drop works too. One image at a time, please.' },
 { id:'convert', title:'Make it yours.', detail:'Choose the format, rename your file, and convert.', tip:'WebP for the web. PNG for transparency. JPG for photos.' },
 { id:'download', title:'Save and go.', detail:'Download your new image. Your original stays untouched.', tip:'No account, no email. Just your file, ready to go.' }
];
---
<section class="shell section how-section" id="how-it-works">
 <div class="section-heading"><div><p class="eyebrow">A LITTLE GUIDANCE FROM LOKI</p><h2>Three steps. Less fuss.</h2></div><a class="text-link" href="/tools/image-converter/">Try it yourself <span aria-hidden="true">↗</span></a></div>
 <div class="how-cards">{steps.map((step,index) => <article class="how-card">
  <span class="how-number">0{index+1}</span><h3>{step.title}</h3><p>{step.detail}</p>
  <div class="how-capture"><img class="lesson-light" src={`/guide/${step.id}-light.webp`} width="900" height="650" loading="lazy" decoding="async" alt={`Image converter ${step.id} screen`} /><img class="lesson-dark" src={`/guide/${step.id}-dark.webp`} width="900" height="650" loading="lazy" decoding="async" alt={`Image converter ${step.id} screen, dark theme`} /></div>
  <details><summary>Loki's tip</summary><p>{step.tip}</p></details>
 </article>)}</div>
</section>
