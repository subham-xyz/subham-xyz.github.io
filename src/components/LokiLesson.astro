---
import { goals } from '../data/goals';
import { toolById } from '../data/tools';
import ToolIcon from './ToolIcon.astro';
import Kitty from './Kitty.astro';
const goal = goals[0];
// Typed requests are parsed locally in English (search-intent.mjs), so the
// examples stay in English on every page.
const examples = [
  'compress image to 50 KB',
  'resize image to 1080x1080',
  'png to jpg',
  'jpg to pdf',
  'merge pdf',
  'odt to pdf',
];
---

<section class="shell section how-section" id="how-it-works" aria-labelledby="loki-title">
  <div class="section-heading">
    <h2 id="loki-title">Tell Loki what you need.</h2>
  </div>
  <form class="tool-search loki-ask" role="search" action="/" method="get">
    <label class="sr-only" for="loki-input">Tell Loki what you need.</label>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
    <input id="loki-input" name="q" type="search" placeholder="What do you need? Compress to 50 KB, merge PDF…" autocomplete="off" enterkeyhint="go" aria-describedby="loki-status" />
    <div class="search-intent-pop" id="loki-intent" hidden><a class="search-intent"></a></div>
  </form>
  <div class="loki-examples" translate="no" lang="en">
    {examples.map((q) => (
      <button type="button" class="loki-example" data-loki-example={q}>{q}</button>
    ))}
  </div>
  <p id="loki-status" class="loki-status" role="status" aria-live="polite"></p>
  <div class="goal-chips" aria-label="Choose your goal">
    {goals.map((g, i) => (
      <button
        class="text-link"
        type="button"
        data-goal={g.id}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >
        {g.label}
      </button>
    ))}
  </div>
  <div id="goal-content" aria-live="polite" aria-atomic="true">
    <div class="how-cards">
      {goal.steps.map((step, i) => (
        <article class="how-card">
          <span class="how-number">0{i + 1}</span>
          <h3 data-goal-step>{step}</h3>
        </article>
      ))}
    </div>
    <div class="loki-recommends">
      <div class="loki-recommends-guide">
        <div class="loki-mini">
          <Kitty small interactive={false} />
        </div>
        <p class="loki-bubble">
          <strong>Loki's tip:</strong> <span id="goal-tip">{goal.tip}</span>
        </p>
      </div>
      {goals.map((g, i) => (
        <div class="rec-cards" data-goal-panel={g.id} hidden={i !== 0}>
          {[g.primary, ...g.related].map((id) => {
            const tool = toolById(id);
            return (
              <a class="rec-card" href={tool.href}>
                <ToolIcon id={tool.id} size="lg" />
                <span>
                  <strong>{tool.name}</strong>
                  <span class="rec-desc">{tool.description}</span>
                </span>
                <span class="rec-go" aria-hidden="true">
                  ↗
                </span>
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</section>
<script>
  import { goals } from '../data/goals';
  document
    .querySelectorAll<HTMLButtonElement>('[data-goal]')
    .forEach((button) =>
      button.addEventListener('click', () => {
        const goal = goals.find((g) => g.id === button.dataset.goal)!;
        document
          .querySelectorAll('[data-goal]')
          .forEach((el) =>
            el.setAttribute('aria-pressed', String(el === button)),
          );
        document
          .querySelectorAll('[data-goal-step]')
          .forEach((el, i) => (el.textContent = goal.steps[i]));
        document.getElementById('goal-tip')!.textContent = goal.tip;
        document
          .querySelectorAll<HTMLElement>('[data-goal-panel]')
          .forEach(
            (panel) => (panel.hidden = panel.dataset.goalPanel !== goal.id),
          );
      }),
    );
</script>
<style>
  .goal-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }
  .goal-chips button {
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: 24px;
  }
  .goal-chips [aria-pressed='true'] {
    background: var(--ink);
    color: var(--canvas);
  }
  .how-card {
    min-height: 130px;
    display: block;
  }
</style>
