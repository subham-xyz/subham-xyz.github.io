---
import { goals } from '../data/goals';
import { toolById } from '../data/tools';
const goal = goals[0];
---

<section class="shell section how-section" id="how-it-works">
  <div class="section-heading">
    <h2>Tell Loki what you need.</h2>
  </div>
  <div class="goal-chips" aria-label="Choose your goal">
    {goals.map((g, i) => (
      <button class="text-link" data-goal={g.id} aria-pressed={i === 0}>
        {g.label}
      </button>
    ))}
  </div>
  <div id="goal-content" aria-live="polite" aria-atomic="true">
    <div class="how-cards">
      {goal.steps.map((step, i) => (
        <article class="how-card">
          <span class="how-number">0{i + 1}</span>
          <h3 data-goal-step>{step}</h3>
        </article>
      ))}
    </div>
    <p id="goal-tip">Loki's tip: {goal.tip}</p>
    <p class="goal-links">
      <a class="button" id="goal-primary" href={toolById(goal.primary).href}>
        {toolById(goal.primary).name}
      </a>
      {goal.related.map((id) => (
        <a data-goal-related class="text-link" href={toolById(id).href}>
          {toolById(id).name}
        </a>
      ))}
    </p>
  </div>
</section>
<script>
  import { goals } from '../data/goals';
  import { toolById } from '../data/tools';
  document
    .querySelectorAll<HTMLButtonElement>('[data-goal]')
    .forEach((button) =>
      button.addEventListener('click', () => {
        const goal = goals.find((g) => g.id === button.dataset.goal)!;
        document
          .querySelectorAll('[data-goal]')
          .forEach((el) =>
            el.setAttribute('aria-pressed', String(el === button)),
          );
        document
          .querySelectorAll('[data-goal-step]')
          .forEach((el, i) => (el.textContent = goal.steps[i]));
        document.getElementById('goal-tip')!.textContent =
          "Loki's tip: " + goal.tip;
        const link = document.getElementById(
          'goal-primary',
        ) as HTMLAnchorElement;
        const tool = toolById(goal.primary);
        link.href = tool.href;
        link.textContent = tool.name;
        document
          .querySelectorAll<HTMLAnchorElement>('[data-goal-related]')
          .forEach((el, i) => {
            const tool = toolById(goal.related[i]);
            el.href = tool.href;
            el.textContent = tool.name;
          });
      }),
    );
</script>
<style>
  .goal-chips,
  .goal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }
  .goal-chips button {
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 24px;
  }
  .goal-chips [aria-pressed='true'] {
    background: var(--ink);
    color: var(--canvas);
  }
  #goal-content {
    min-height: 350px;
  }
  #goal-tip {
    margin: 24px 0;
    min-height: 3.5em;
  }
  .how-card {
    height: 160px;
    display: block;
  }
  @media (max-width: 767px) {
    .how-card {
      display: block;
    }
    #goal-tip {
      min-height: 100px;
    }
    .goal-links {
      min-height: 144px;
      align-content: start;
    }
    #goal-content {
      min-height: 850px;
    }
  }
</style>
