---
const { tool } = Astro.props;
const mode = tool.id;
---

<section
  class="workspace local-tool"
  id="image-editor"
  data-mode={mode}
  aria-label={tool.name}
>
  <div data-drop>
    <label for="local-files">
      Choose{' '}
      {mode === 'rotate-image' || mode === 'convert-from-jpg'
        ? 'images'
        : 'an image'}
    </label>
    <input
      id="local-files"
      type="file"
      multiple={['rotate-image', 'convert-from-jpg'].includes(mode)}
      accept={
        mode === 'convert-to-jpg'
          ? '.png,.jpg,.jpeg,.webp,.gif,.bmp,.avif,.svg,.tif,.tiff'
          : '.png,.jpg,.jpeg,.webp,.gif,.bmp,.avif'
      }
    />
    <p class="field-hint">
      Drop files here. Up to 20 MB each, 16 megapixels, 30 files / 80 MB total.
      HEIC requires export to JPG first. Metadata is removed.
    </p>
  </div>
  <p id="local-status" class="local-status" role="status" aria-live="polite">
    100% on your device
  </p>
  <div id="local-editor" hidden>
    <div id="image-order" class="local-actions"></div>
    <div class="local-grid">
      <div>
        <div class="local-preview">
          <canvas
            id="edit-preview"
            aria-label="Image preview. Crop or blur by dragging; numeric controls are also available."
          ></canvas>
        </div>
        <p class="field-hint">
          Preview updates locally. Changes apply to a new copy.
        </p>
      </div>
      <div>
        {mode === 'crop-image' && (
          <>
            <label for="crop-ratio">Aspect ratio</label>
            <select id="crop-ratio">
              <option value="0">Free crop</option>
              <option value="1">Square</option>
              <option value="1.3333333333">4:3</option>
              <option value="1.7777777778">16:9</option>
              <option value="0.75">3:4</option>
            </select>
            <p>Drag inside to move, or drag a corner handle to resize.</p>
          </>
        )}
        {['crop-image', 'blur-face'].includes(mode) && (
          <>
            <div class="control-pair">
              {['x', 'y', 'w', 'h'].map((key) => (
                <div>
                  <label for={`edit-${key}`}>
                    {{ x: 'Left', y: 'Top', w: 'Width', h: 'Height' }[key]} (px)
                  </label>
                  <input
                    id={`edit-${key}`}
                    type="number"
                    min={key === 'x' || key === 'y' ? 0 : 1}
                    value="0"
                  />
                </div>
              ))}
            </div>
            {mode === 'blur-face' && (
              <>
                <label for="blur-mode">Selection tool</label>
                <select id="blur-mode">
                  <option value="rectangle">Rectangle</option>
                  <option value="brush">Brush</option>
                </select>
                <label for="blur-size">Blur / brush radius (px)</label>
                <input
                  id="blur-size"
                  type="number"
                  min="4"
                  max="100"
                  value="24"
                />
                <div class="local-actions">
                  <button id="add-blur" class="text-link">
                    Blur numeric rectangle
                  </button>
                  <button id="clear-blur" class="text-link">
                    Clear regions
                  </button>
                </div>
                <p>
                  Manual only. Blur is visual obfuscation, not secure removal.
                  Inspect faces and plates before sharing.
                </p>
              </>
            )}
          </>
        )}
        {mode === 'rotate-image' && (
          <>
            <label for="angle">Rotation (degrees clockwise)</label>
            <input id="angle" type="number" min="-360" max="360" value="90" />
            <label for="orientation-filter">Apply to</label>
            <select id="orientation-filter">
              <option value="all">All images</option>
              <option value="landscape">Landscape only</option>
              <option value="portrait">Portrait only</option>
            </select>
          </>
        )}
        {['meme-generator', 'photo-editor', 'watermark-image'].includes(
          mode,
        ) && (
          <>
            <label for="edit-text">
              {mode === 'meme-generator' ? 'Top caption' : 'Text'}
            </label>
            <input
              id="edit-text"
              maxlength="160"
              value={
                mode === 'meme-generator' ? 'HELLO, LOKI' : 'Made with care'
              }
            />
            {mode === 'meme-generator' && (
              <>
                <label for="bottom-text">Bottom caption</label>
                <input
                  id="bottom-text"
                  maxlength="160"
                  value="A LITTLE LESS FUSS"
                />
              </>
            )}
            <div class="control-pair">
              <div>
                <label for="font-size">Font size (px)</label>
                <input
                  id="font-size"
                  type="number"
                  min="8"
                  max="600"
                  value="40"
                />
              </div>
              <div>
                <label for="text-color">Text / frame colour</label>
                <input id="text-color" type="color" value="#ffffff" />
              </div>
            </div>
            <label for="text-font">Font</label>
            <select id="text-font">
              <option value="sans-serif">Sans serif</option>
              <option value="serif">Serif</option>
              <option value="monospace">Monospace</option>
            </select>
            <label for="text-align">Alignment</label>
            <select id="text-align">
              <option value="center">Center</option>
              <option value="left">Left</option>
              <option value="right">Right</option>
            </select>
            <label>
              <input id="text-outline" type="checkbox" checked /> Dark outline
            </label>
            {mode !== 'meme-generator' && (
              <>
                <div class="control-pair">
                  <div>
                    <label for="stamp-x">Position across (%)</label>
                    <input
                      id="stamp-x"
                      type="number"
                      min="0"
                      max="100"
                      value="50"
                    />
                  </div>
                  <div>
                    <label for="stamp-y">Position down (%)</label>
                    <input
                      id="stamp-y"
                      type="number"
                      min="0"
                      max="100"
                      value="50"
                    />
                  </div>
                </div>
                <label for="stamp-opacity">Opacity (%)</label>
                <input
                  id="stamp-opacity"
                  type="range"
                  min="5"
                  max="100"
                  value="70"
                />
                <label for="stamp-rotation">Text / mark rotation</label>
                <input
                  id="stamp-rotation"
                  type="number"
                  min="-180"
                  max="180"
                  value="0"
                />
              </>
            )}
            {mode === 'watermark-image' && (
              <>
                <label for="overlay-file">
                  Optional image watermark (PNG/JPG/WebP)
                </label>
                <input
                  id="overlay-file"
                  type="file"
                  accept=".png,.jpg,.jpeg,.webp"
                />
                <label for="stamp-scale">Image width (% of canvas)</label>
                <input
                  id="stamp-scale"
                  type="range"
                  min="5"
                  max="100"
                  value="30"
                />
                <label>
                  <input id="stamp-tile" type="checkbox" /> Repeat across image
                </label>
              </>
            )}
            {mode === 'photo-editor' && (
              <>
                <label for="effect">Effect</label>
                <select id="effect">
                  <option value="none">Original</option>
                  <option value="grayscale(1)">Monochrome</option>
                  <option value="sepia(0.8)">Warm sepia</option>
                  <option value="contrast(1.3) saturate(1.2)">Vivid</option>
                  <option value="brightness(1.2)">Brighter</option>
                </select>
                <label for="frame-size">Frame width (px)</label>
                <input
                  id="frame-size"
                  type="number"
                  min="0"
                  max="200"
                  value="0"
                />
                <label>
                  <input id="loki-sticker" type="checkbox" /> Add original Loki
                  sticker
                </label>
              </>
            )}
          </>
        )}
        <label for="edit-format">Output format</label>
        <select id="edit-format">
          {mode === 'convert-to-jpg' ? (
            <option value="image/jpeg">JPG</option>
          ) : (
            <>
              <option value="image/png">PNG</option>
              <option value="image/jpeg">JPG</option>
              <option value="image/webp">WebP</option>
              {mode === 'convert-from-jpg' && (
                <option value="image/gif">Animated GIF / single GIF</option>
              )}
            </>
          )}
        </select>
        <label for="edit-background">JPG / GIF background</label>
        <input id="edit-background" type="color" value="#ffffff" />
        {mode === 'convert-from-jpg' && (
          <>
            <label for="frame-delay">GIF frame delay (ms)</label>
            <input
              id="frame-delay"
              type="number"
              min="20"
              max="10000"
              value="500"
            />
            <label>
              <input id="gif-loop" type="checkbox" checked /> Loop GIF
            </label>
            <p>
              GIF uses up to 256 colours and an 800 px maximum side. Move frames
              using the order buttons above.
            </p>
          </>
        )}
      </div>
    </div>
    <div class="local-actions">
      <button id="edit-export" class="button">
        Export image
      </button>
      <button id="edit-reset" class="text-link">
        Reset
      </button>
    </div>
    <div id="local-output" class="local-output"></div>
  </div>
</section>
<script src="../scripts/image-editor.ts"></script>
