---
import Kitty from './Kitty.astro';
const { extended = false, fontFinder = false } = Astro.props;
---
<div id="upload-panel" class="state-panel"><div id="dropzone" class="dropzone"><Kitty small interactive={false} /><h2>A new format is a drop away.</h2><p>Drag your image here, or choose one below.</p><label class="button" for="file-input">Choose an image <span aria-hidden="true">↗</span></label><input class="file-input" type="file" id="file-input" accept={fontFinder ? ".png,.jpg,.jpeg,.webp,.gif" : extended ? ".jpg,.jpeg,.png,.webp,.bmp,.gif,.avif" : ".jpg,.jpeg,.png,.webp"} aria-describedby="file-help" /><p class="file-help" id="file-help">{fontFinder ? 'JPG, PNG, WebP or GIF' : extended ? 'JPG, PNG, WebP, BMP, GIF (still), supported AVIF' : 'JPG, PNG or WebP'} · Up to {fontFinder ? 8 : 20} MB and 16 megapixels</p></div><p class="local-note">⌁ Your image stays on your device. Always.</p></div>