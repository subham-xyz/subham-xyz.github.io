---
import Kitty from './Kitty.astro';
const { extended = false, fontFinder = false, mode = 'converter' } = Astro.props;
const heading = fontFinder
  ? 'Find a font from an image'
  : mode === 'compressor'
    ? 'Compress an image'
    : mode === 'resizer'
      ? 'Resize an image'
      : 'Convert an image';
---

<div id="upload-panel" class="state-panel">
  <div id="dropzone" class="dropzone app-upload">
    <Kitty small interactive={false} />
    <h2>{heading}</h2>
    <p>Choose an image, or drop it here.</p>
    <label class="button app-select" for="file-input">Select image <span aria-hidden="true">↗</span></label>
    <input
      class="file-input"
      type="file"
      id="file-input"
      accept={fontFinder ? '.png,.jpg,.jpeg,.webp,.gif' : extended ? '.jpg,.jpeg,.png,.webp,.bmp,.gif,.avif' : '.jpg,.jpeg,.png,.webp'}
      aria-describedby="file-help"
    />
    <p class="file-help" id="file-help">
      {fontFinder ? 'JPG, PNG, WebP or GIF' : extended ? 'JPG, PNG, WebP, BMP, GIF (still), supported AVIF' : 'JPG, PNG or WebP'} · Up to {fontFinder ? 8 : 20} MB and 16 megapixels
    </p>
  </div>
  <p class="local-note">Your image stays on your device. Always.</p>
</div>
