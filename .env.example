# Feedback form (https://web3forms.com): create a free access key for the inbox
# that should receive feedback. Copy this file to .env and paste the key.
# The inbox address itself never appears in this repository or the website.
PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 (optional). Leave empty to load no analytics at all.
# Example format: G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification (optional): paste only the
# content="..." value from the meta tag Search Console gives you.
PUBLIC_GOOGLE_SITE_VERIFICATION=
