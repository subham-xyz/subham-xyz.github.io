# Security and caching headers (Cloudflare Pages / Netlify format).
# The Content-Security-Policy itself is set per page in Layout.astro.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Upscale Image: cross-origin isolation lets the AI runtime use several CPU threads
# (SharedArrayBuffer). "credentialless" keeps any cross-origin resource loadable.
/upscale-image/
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/_astro/*
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin

/local-engine/*
  Cache-Control: public, max-age=604800
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin

/models/*
  Cache-Control: public, max-age=2592000
  Cross-Origin-Resource-Policy: same-origin
